<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CYHLocker.Mobile.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CYHLocker.Mobile.App.Views"
    Title="CYH Local SMS">

    <TabBar>
        <Tab Title="Messages" Route="conversations">
            <ShellContent
                Title="Messages"
                ContentTemplate="{DataTemplate views:ConversationsPage}"
                Route="conversationsPage" />
        </Tab>

        <Tab Title="Compose" Route="compose">
            <ShellContent
                Title="Compose"
                ContentTemplate="{DataTemplate views:ComposePage}"
                Route="composePage" />
        </Tab>

        <Tab Title="SIM &amp; Settings" Route="settings">
            <ShellContent
                Title="Settings"
                ContentTemplate="{DataTemplate views:SettingsPage}"
                Route="settingsPage" />
        </Tab>
    </TabBar>

</Shell>
