<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CYHLocker.Mobile.App.ViewModels"
             xmlns:models="clr-namespace:CYHLocker.Mobile.App.Models"
             x:Class="CYHLocker.Mobile.App.Views.ConversationsPage"
             x:DataType="vm:ConversationsViewModel"
             Title="Local SMS"
             BackgroundColor="{AppThemeBinding Light=#F4F6F9, Dark=#12141A}">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Top App Bar / Actions -->
        <Border Grid.Row="0"
                Padding="16,12"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E212B}"
                StrokeThickness="0">
            <Grid ColumnDefinitions="*, Auto, Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="CYH Local SMS"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#111827, Dark=#FFFFFF}" />
                    <Label Text="SIM Card Messaging (Offline/Direct)"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                </VerticalStackLayout>

                <!-- Simulate Test SMS Button -->
                <Button Grid.Column="1"
                        Text="+ Test SMS"
                        FontSize="11"
                        HeightRequest="34"
                        Padding="10,0"
                        Margin="4,0"
                        CornerRadius="8"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        Command="{Binding SimulateIncomingSmsCommand}"
                        ToolTipProperties.Text="Simulate an incoming test SMS" />

                <!-- Refresh Button -->
                <Button Grid.Column="2"
                        Text="↻"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="34"
                        WidthRequest="34"
                        Padding="0"
                        CornerRadius="8"
                        BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                        TextColor="{AppThemeBinding Light=#1F2937, Dark=#F9FAFB}"
                        Command="{Binding LoadConversationsCommand}" />
            </Grid>
        </Border>

        <!-- Search Bar -->
        <Border Grid.Row="1"
                Margin="16,10,16,6"
                Padding="12,0"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2D3343}"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E212B}"
                HeightRequest="46">
            <Grid ColumnDefinitions="Auto, *">
                <Label Grid.Column="0"
                       Text="🔍"
                       VerticalOptions="Center"
                       Margin="0,0,8,0"
                       FontSize="14" />
                <Entry Grid.Column="1"
                       Placeholder="Search contact ya message..."
                       PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                       TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}"
                       Text="{Binding SearchQuery, Mode=TwoWay}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Conversations List -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadConversationsCommand}">
            <CollectionView ItemsSource="{Binding FilteredConversations}"
                            SelectionMode="None"
                            EmptyView="Koi SMS conversation nahi mila. Niche '+' daba kar naya SMS bhejein!">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SmsConversationItem">
                        <Border Margin="16,2,16,2"
                                Padding="12"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2D3343}"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E212B}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConversationTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <!-- Avatar -->
                                <Border Grid.Column="0"
                                        WidthRequest="46"
                                        HeightRequest="46"
                                        StrokeShape="RoundRectangle 23"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding AvatarColor}">
                                    <Label Text="{Binding Initials}"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- Details -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding DisplayTitle}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding LastMessageBody}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#4B5563, Dark=#9CA3AF}"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Subtitle}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                                           IsVisible="{Binding Subtitle, Converter={StaticResource StringIsNotNullOrEmptyConverter}, FallbackValue=False}" />
                                </VerticalStackLayout>

                                <!-- Time & Badge -->
                                <VerticalStackLayout Grid.Column="2"
                                                     HorizontalOptions="End"
                                                     VerticalOptions="Center"
                                                     Spacing="4">
                                    <Label Text="{Binding FormattedTime}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
                                    <Border IsVisible="{Binding UnreadCount, Converter={StaticResource IntGreaterThanZeroConverter}, FallbackValue=False}"
                                            BackgroundColor="#10B981"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            HeightRequest="20"
                                            Padding="6,0"
                                            HorizontalOptions="End">
                                        <Label Text="{Binding UnreadCount}"
                                               FontSize="10"
                                               TextColor="White"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Floating Compose Button (+) -->
        <Button Grid.Row="2"
                Text="+"
                FontSize="28"
                FontAttributes="Bold"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                Margin="0,0,24,24"
                HorizontalOptions="End"
                VerticalOptions="End"
                BackgroundColor="#512BD4"
                TextColor="White"
                Clicked="OnComposeClicked"
                Shadow="{AppThemeBinding Light={OnPlatform Default=null}, Dark={OnPlatform Default=null}}" />
    </Grid>
</ContentPage>
