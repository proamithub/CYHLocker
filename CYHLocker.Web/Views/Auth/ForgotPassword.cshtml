@model CYHLocker.Data.DTOs.ForgotPasswordDto
@{
    ViewData["Title"] = "Forgot Password — CYHLocker";
    Layout = "_Layout";
}

<div class="auth-wrapper">
    <div class="max-w-md mx-auto px-4 w-100">
        <div class="auth-card p-4 p-md-5">

            <div class="text-center mb-4">
                <span style="font-size:2rem;">🔑</span>
                <h3 class="fw-bold text-white mt-2 mb-1">Reset Password</h3>
                <p class="small text-muted mb-0">Enter your registered email to receive recovery instructions</p>
            </div>

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="auth-label">Registered Email</label>
                    <input asp-for="Email" class="form-control auth-input" placeholder="you@domain.com" autocomplete="email" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-glow" style="padding:12px; border-radius:12px; font-size:1rem;">
                        Send Reset Link →
                    </button>
                </div>

                <div class="text-center pt-2 border-top" style="border-color:rgba(255,255,255,0.08) !important;">
                    <a asp-action="Login" class="small text-decoration-none" style="color:#38bdf8;">
                        ← Back to Sign In
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
