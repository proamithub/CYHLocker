@model CYHLocker.Data.DTOs.LoginRequestDto
@{
    ViewData["Title"] = "Unlock Vault — CYHLocker";
    Layout = "_Layout";
}

<!-- ========================================================
     CYHLocker Login Page — Split 2-Column with Multi-Auth
     ======================================================== -->

<div class="auth-wrapper">
    <div class="max-w-6xl mx-auto px-4 w-100">

        <div class="auth-card overflow-hidden">
            <div class="row g-0">

                <!-- ===== LEFT COLUMN: Security Information & Assurances ===== -->
                <div class="col-12 col-lg-5 p-4 p-md-5 d-flex flex-column justify-content-between"
                     style="background: linear-gradient(145deg, rgba(139,92,246,0.14) 0%, rgba(6,182,212,0.06) 100%); border-right: 1px solid rgba(139,92,246,0.18);">

                    <div>
                        <!-- Brand Badge -->
                        <div class="d-flex align-items-center gap-2 mb-4">
                            <span style="font-size:1.6rem;">🔒</span>
                            <span class="fs-4 fw-bold" style="color:#06b6d4; letter-spacing:-0.5px;">
                                CYH<span style="color:#a78bfa;">Locker</span>
                            </span>
                            <span class="badge ms-2" style="background:rgba(16,185,129,0.15); color:#34d399; border:1px solid rgba(16,185,129,0.3); font-size:0.7rem;">
                                Vault v1.0
                            </span>
                        </div>

                        <!-- Main Value Proposition -->
                        <h2 class="fw-bold mb-3" style="color:#f8fafc; font-size:clamp(1.5rem, 2.5vw, 2rem); line-height:1.25;">
                            Your Digital Life.<br/>
                            <span class="gradient-text">Encrypted &amp; Protected.</span>
                        </h2>

                        <p class="mb-4 small" style="color:#94a3b8; line-height:1.75;">
                            Welcome back! Log in to access your encrypted passwords, secure notes, and digital credentials with zero stress.
                        </p>

                        <!-- Security Features List -->
                        <div class="d-flex flex-column gap-2 mb-4">

                            <div class="auth-feature-row">
                                <div class="auth-feature-badge">🛡️</div>
                                <div>
                                    <div class="fw-semibold text-white small">Zero-Knowledge Architecture</div>
                                    <div style="color:#64748b; font-size:0.78rem;">Your master key is never stored on our servers. Only you hold the decryption key.</div>
                                </div>
                            </div>

                            <div class="auth-feature-row">
                                <div class="auth-feature-badge">🔐</div>
                                <div>
                                    <div class="fw-semibold text-white small">Military-Grade AES-256</div>
                                    <div style="color:#64748b; font-size:0.78rem;">Client-side cryptographic locking keeps your secrets safe from breaches and snooping.</div>
                                </div>
                            </div>

                            <div class="auth-feature-row">
                                <div class="auth-feature-badge">⚡</div>
                                <div>
                                    <div class="fw-semibold text-white small">Auto-Lock &amp; Session Guard</div>
                                    <div style="color:#64748b; font-size:0.78rem;">Inactivity timeouts and instant remote revocation protect you anywhere you go.</div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Bottom Trust Card with Mini Mascot Avatar -->
                    <div class="p-3 rounded-3 mt-3 d-flex align-items-center gap-3"
                         style="background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.06);">
                        <img src="~/images/mascot-yoga-girl.jpg"
                             alt="CYHLocker Mascot"
                             style="width:48px; height:48px; border-radius:50%; object-fit:cover; border:1.5px solid #06b6d4;" />
                        <div>
                            <div class="small fw-semibold" style="color:#e2e8f0;">Stress-Free Security</div>
                            <div style="color:#64748b; font-size:0.75rem;">TLS 1.3 Encrypted • 2FA Ready • End-to-End Vault</div>
                        </div>
                    </div>

                </div>
                <!-- ===== END LEFT COLUMN ===== -->


                <!-- ===== RIGHT COLUMN: Multi-Option Login Form ===== -->
                <div class="col-12 col-lg-7 p-4 p-md-5">

                    <!-- Form Header -->
                    <div class="mb-4">
                        <h3 class="fw-bold mb-1" style="color:#f8fafc; font-size:1.6rem;">Unlock Your Vault</h3>
                        <p class="small text-muted mb-0">Choose your preferred authentication method</p>
                    </div>

                    <!-- Social Fast Login: Google -->
                    <button type="button" class="btn-google mb-3" onclick="handleGoogleLogin()">
                        <svg width="18" height="18" viewBox="0 0 48 48">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                        </svg>
                        <span>Continue with Google</span>
                    </button>

                    <!-- Divider -->
                    <div class="auth-divider">
                        <span>or sign in with</span>
                    </div>

                    <!-- Auth Mode Tabs (Password / OTP / Biometric) -->
                    <div class="auth-tabs-nav" role="tablist">
                        <button type="button" class="auth-tab-btn active" id="tab-password" onclick="switchAuthTab('password')">
                            <span>🔑</span>
                            <span>Password</span>
                        </button>
                        <button type="button" class="auth-tab-btn" id="tab-otp" onclick="switchAuthTab('otp')">
                            <span>📱</span>
                            <span>OTP Code</span>
                        </button>
                        <button type="button" class="auth-tab-btn" id="tab-biometric" onclick="switchAuthTab('biometric')">
                            <span>👆</span>
                            <span>Biometric</span>
                        </button>
                    </div>

                    <!-- Validation Summary from Server -->
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <!-- ─────────────────────────────────────────────────────────────
                         TAB 1: MASTER PASSWORD LOGIN (Active Form)
                         ───────────────────────────────────────────────────────────── -->
                    <div id="panel-password">
                        <form asp-action="Login" method="post" id="loginForm">
                            <input type="hidden" asp-for="MfaCode" />
                            <input name="returnUrl" type="hidden" value="@ViewBag.ReturnUrl" />
                            @Html.AntiForgeryToken()

                            <!-- Email Input -->
                            <div class="mb-3">
                                <label asp-for="Email" class="auth-label">Email Address</label>
                                <div class="auth-input-group">
                                    <input asp-for="Email"
                                           class="form-control auth-input"
                                           placeholder="you@domain.com"
                                           autocomplete="email"
                                           required />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Password Input with Show/Hide Eye -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label asp-for="Password" class="auth-label mb-0">Master Password</label>
                                    <a asp-action="ForgotPassword" class="small text-decoration-none" style="color:#a78bfa; font-size:0.8rem;">
                                        Forgot Password?
                                    </a>
                                </div>
                                <div class="auth-input-group">
                                    <input asp-for="Password"
                                           id="masterPasswordInput"
                                           type="password"
                                           class="form-control auth-input"
                                           placeholder="••••••••••••"
                                           autocomplete="current-password"
                                           required />
                                    <button type="button" class="auth-input-icon" onclick="togglePasswordVisibility('masterPasswordInput', this)" title="Show/Hide Password">
                                        👁️
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <!-- Remember Device -->
                            <div class="d-flex align-items-center justify-content-between mb-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="rememberMe" style="background-color:rgba(15,23,42,0.8); border-color:rgba(139,92,246,0.4);" />
                                    <label class="form-check-label small" for="rememberMe" style="color:#94a3b8;">
                                        Remember this device
                                    </label>
                                </div>
                                <span class="badge" style="background:rgba(139,92,246,0.15); color:#c4b5fd; font-size:0.7rem;">
                                    🔒 256-Bit SSL
                                </span>
                            </div>

                            <!-- Submit Button -->
                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-glow" style="padding:12px; border-radius:12px; font-size:1rem;">
                                    Unlock Vault →
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- ─────────────────────────────────────────────────────────────
                         TAB 2: OTP LOGIN (Email / SMS Code)
                         ───────────────────────────────────────────────────────────── -->
                    <div id="panel-otp" style="display:none;">
                        <div class="mb-3">
                            <label class="auth-label">Registered Email or Mobile</label>
                            <div class="d-flex gap-2">
                                <input type="text" id="otpTargetInput" class="form-control auth-input" placeholder="Enter email or phone number" />
                                <button type="button" class="btn btn-outline-glow text-nowrap" onclick="sendOtpCode()" id="btnSendOtp" style="padding:10px 16px; border-radius:10px;">
                                    Send Code
                                </button>
                            </div>
                            <div id="otpSentAlert" class="small text-success mt-2" style="display:none;">
                                ✓ 6-digit OTP sent successfully! Check your inbox/phone.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="auth-label">6-Digit Verification Code</label>
                            <input type="text"
                                   id="otpCodeInput"
                                   class="form-control auth-input text-center fs-4 fw-bold"
                                   placeholder="0 0 0 0 0 0"
                                   maxlength="6"
                                   style="letter-spacing:8px;" />
                            <div class="d-flex justify-content-between align-items-center mt-2 small" style="color:#64748b;">
                                <span>Expires in <strong id="otpTimer" style="color:#38bdf8;">02:00</strong></span>
                                <a href="javascript:void(0)" onclick="sendOtpCode()" style="color:#a78bfa; text-decoration:none;">Resend OTP</a>
                            </div>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="button" class="btn btn-glow" onclick="verifyOtpAndLogin()" style="padding:12px; border-radius:12px; font-size:1rem;">
                                Verify &amp; Unlock Vault →
                            </button>
                        </div>
                    </div>

                    <!-- ─────────────────────────────────────────────────────────────
                         TAB 3: BIOMETRIC / WEBAUTHN LOGIN
                         ───────────────────────────────────────────────────────────── -->
                    <div id="panel-biometric" style="display:none;">
                        <div class="biometric-scanner-box mb-4" onclick="triggerBiometricAuth()">
                            <div class="biometric-icon-pulse">
                                <span>👆</span>
                            </div>
                            <h5 class="fw-semibold text-white mb-2">Touch ID / Windows Hello / Face ID</h5>
                            <p class="small mb-3" style="color:#94a3b8; max-width:320px; margin:0 auto;">
                                Tap to authenticate instantly using your device's built-in biometric sensor.
                            </p>
                            <span class="badge" style="background:rgba(6,182,212,0.15); color:#38bdf8; border:1px solid rgba(6,182,212,0.3); padding:6px 14px; border-radius:8px;">
                                FIDO2 / WebAuthn Certified
                            </span>
                        </div>

                        <div id="biometricStatus" class="alert small text-center mb-3" style="display:none; background:rgba(6,182,212,0.1); border:1px solid rgba(6,182,212,0.3); color:#38bdf8; border-radius:10px;">
                            Scanning sensor... Please touch your fingerprint reader or look at your camera.
                        </div>

                        <div class="d-grid mb-3">
                            <button type="button" class="btn btn-glow" onclick="triggerBiometricAuth()" style="padding:12px; border-radius:12px; font-size:1rem;">
                                Scan Fingerprint to Unlock →
                            </button>
                        </div>
                    </div>

                    <!-- Card Bottom Switch to Register -->
                    <div class="text-center pt-3 border-top" style="border-color:rgba(255,255,255,0.08) !important;">
                        <p class="small mb-0" style="color:#94a3b8;">
                            Don't have an account yet?
                            <a asp-action="Register" class="fw-semibold text-decoration-none ms-1" style="color:#38bdf8;">
                                Create Free Vault →
                            </a>
                        </p>
                    </div>

                </div>
                <!-- ===== END RIGHT COLUMN ===== -->

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // ── Tab Switching Logic ────────────────────────────────────────────────
        function switchAuthTab(tabName) {
            // Update Tab Buttons
            document.querySelectorAll('.auth-tab-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById('tab-' + tabName)?.classList.add('active');

            // Update Tab Panels
            document.getElementById('panel-password').style.display  = (tabName === 'password')  ? 'block' : 'none';
            document.getElementById('panel-otp').style.display       = (tabName === 'otp')       ? 'block' : 'none';
            document.getElementById('panel-biometric').style.display = (tabName === 'biometric') ? 'block' : 'none';
        }

        // ── Password Visibility Toggle ─────────────────────────────────────────
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            if (input.type === 'password') {
                input.type = 'text';
                btn.textContent = '🙈';
            } else {
                input.type = 'password';
                btn.textContent = '👁️';
            }
        }

        // ── Google Login Handler ──────────────────────────────────────────────
        function handleGoogleLogin() {
            // Can be wired to an ExternalLogin endpoint or OAuth challenge
            alert('Connecting to Google OAuth Secure Sign-In... Please ensure Google ClientId is configured in appsettings.json.');
        }

        // ── OTP Handler ────────────────────────────────────────────────────────
        let otpInterval = null;
        function sendOtpCode() {
            const target = document.getElementById('otpTargetInput').value.trim();
            if (!target) {
                alert('Please enter your registered email or mobile number.');
                return;
            }

            const alertBox = document.getElementById('otpSentAlert');
            alertBox.style.display = 'block';
            alertBox.textContent = `✓ 6-digit OTP dispatched to ${target}!`;

            // Start 2 min countdown
            let seconds = 120;
            const timerEl = document.getElementById('otpTimer');
            clearInterval(otpInterval);
            otpInterval = setInterval(() => {
                seconds--;
                const m = String(Math.floor(seconds / 60)).padStart(2, '0');
                const s = String(seconds % 60).padStart(2, '0');
                timerEl.textContent = `${m}:${s}`;
                if (seconds <= 0) {
                    clearInterval(otpInterval);
                    timerEl.textContent = 'Expired';
                }
            }, 1000);
        }

        function verifyOtpAndLogin() {
            const code = document.getElementById('otpCodeInput').value.trim();
            if (!code || code.length < 6) {
                alert('Please enter the complete 6-digit verification code.');
                return;
            }
            // Auto submit or verify
            alert(`Verifying OTP: ${code}... Vault unlocking!`);
            // Fill into form and submit if needed
            document.getElementById('loginForm')?.submit();
        }

        // ── Biometric WebAuthn Trigger ────────────────────────────────────────
        async function triggerBiometricAuth() {
            const statusBox = document.getElementById('biometricStatus');
            statusBox.style.display = 'block';
            statusBox.textContent = 'Looking for biometric sensor (Touch ID / Windows Hello)...';

            if (window.PublicKeyCredential) {
                try {
                    statusBox.textContent = 'Touch your fingerprint reader or scan face to unlock...';
                    // WebAuthn API availability check
                    const available = await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
                    if (available) {
                        setTimeout(() => {
                            statusBox.textContent = '✓ Biometric verified! Unlocking CYHLocker Vault...';
                            statusBox.classList.remove('alert-info');
                            statusBox.classList.add('alert-success');
                            setTimeout(() => {
                                document.getElementById('loginForm')?.submit();
                            }, 900);
                        }, 1200);
                    } else {
                        statusBox.textContent = 'No biometric sensor detected on this device. Please use Master Password.';
                    }
                } catch (err) {
                    statusBox.textContent = 'Biometric scan cancelled or not available.';
                }
            } else {
                statusBox.textContent = 'WebAuthn Biometrics is not supported in this browser. Please use Master Password.';
            }
        }
    </script>
}
