@using System.Security.Claims
@{
    ViewData["Title"] = "My Account";
    Layout = "_Layout";
    var sessions = ViewBag.Sessions as List<CYHLocker.Data.DTOs.SessionDto> ?? new();
    var currentSid = ViewBag.CurrentSessionId as string;
    var userEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? "";
    var userName  = User.Identity?.Name ?? "";
}

<h2 class="mb-4">👤 My Account</h2>

<div class="row">
    <!-- Profile Section -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Profile Information</h5>
            </div>
            <div class="card-body">
                <form asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" value="@userEmail" readonly disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input name="fullName" class="form-control" value="@userName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone Number</label>
                        <input name="phoneNumber" class="form-control" placeholder="+1 234 567 8900" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Avatar URL</label>
                        <input name="avatarUrl" class="form-control" placeholder="https://..." />
                    </div>
                    <button type="submit" class="btn btn-primary">Save Profile</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Security Section -->
    <div class="col-md-6 mb-4">
        <!-- Change Password Card -->
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">🔑 Password</h5>
            </div>
            <div class="card-body">
                <a asp-action="ChangePassword" class="btn btn-outline-warning w-100">Change Password</a>
            </div>
        </div>

        <!-- MFA Card -->
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">📱 Two-Factor Authentication</h5>
            </div>
            <div class="card-body">
                @if (User.Claims.Any(c => c.Type == "mfa_enabled" && c.Value == "true"))
                {
                    <p class="text-success">✅ MFA is <strong>enabled</strong></p>
                    <form asp-action="DisableMfa" method="post" onsubmit="return confirm('Disable MFA? Enter your password to confirm.');">
                        @Html.AntiForgeryToken()
                        <div class="input-group">
                            <input name="password" type="password" class="form-control" placeholder="Current password" required />
                            <button type="submit" class="btn btn-outline-danger">Disable MFA</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="text-muted">MFA is <strong>not enabled</strong>. Add extra security to your account.</p>
                    <a asp-action="SetupMfa" class="btn btn-info text-white w-100">Enable MFA</a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Active Sessions -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">🖥️ Active Sessions</h5>
        @if (sessions.Count > 1)
        {
            <form asp-action="RevokeAllSessions" method="post" class="mb-0"
                  onsubmit="return confirm('Revoke all other sessions?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-light">Revoke All Others</button>
            </form>
        }
    </div>
    <div class="card-body p-0">
        @if (!sessions.Any())
        {
            <p class="text-muted p-3 mb-0">No active sessions found.</p>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Device</th>
                        <th>IP Address</th>
                        <th>Last Active</th>
                        <th>Expires</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in sessions)
                    {
                        <tr class="@(s.IsCurrent ? "table-success" : "")">
                            <td>
                                @s.DeviceName
                                @if (s.IsCurrent)
                                {
                                    <span class="badge bg-success ms-1">Current</span>
                                }
                            </td>
                            <td>@(s.ClientIp ?? "-")</td>
                            <td>@s.LastActiveAt.ToString("MMM dd, HH:mm") UTC</td>
                            <td>@s.ExpiresAt.ToString("MMM dd, HH:mm") UTC</td>
                            <td>
                                @if (!s.IsCurrent)
                                {
                                    <form asp-action="RevokeSession" method="post" class="mb-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sessionId" value="@s.SessionId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Revoke this session?');">
                                            Revoke
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
