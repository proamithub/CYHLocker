@model CYHLocker.Data.DTOs.ChangePasswordDto
@{
    ViewData["Title"] = "Change Master Password";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="glass-card p-4 text-center" style="background:#0b1120; border:1px solid rgba(6,182,212,0.35); border-radius:18px; box-shadow:0 25px 60px rgba(0,0,0,0.7);">
                <div style="width:58px; height:58px; margin:0 auto 1.25rem; border-radius:14px; background:rgba(6,182,212,0.15); border:1px solid rgba(6,182,212,0.4); display:flex; align-items:center; justify-content:center; font-size:2rem; box-shadow:0 0 20px rgba(6,182,212,0.25);">
                    🔑
                </div>
                <h4 class="fw-bold text-light mb-2">Change Master Password</h4>
                <p class="text-secondary small mb-4" style="line-height:1.5;">
                    CYHLocker master password securely protects your vault credentials. Click below if the popup did not open automatically.
                </p>
                <button type="button" class="btn btn-glow w-100 py-2 mb-3 fw-semibold" onclick="openChangePasswordModal()">
                    🔑 Open Change Password Popup
                </button>
                <a asp-area="User" asp-controller="Dashboard" asp-action="Index" class="btn btn-sm btn-outline-secondary w-100 py-2" style="border-color:rgba(255,255,255,0.15); color:#94a3b8;">
                    ← Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(function() {
                if (typeof openChangePasswordModal === 'function') {
                    openChangePasswordModal();
                }
            }, 150);
        });
    </script>
}
