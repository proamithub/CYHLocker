<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CYHLocker — Your personal password vault secured with military-grade AES-256 encryption." />
    <title>@ViewData["Title"] - CYHLocker</title>

    <!-- Google Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS Play CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#8b5cf6',
                        cyan:    '#06b6d4',
                        dark:    '#080c18',
                    }
                }
            }
        }
    </script>

    <!-- Bootstrap (kept for existing pages/forms) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Custom CSS & Animations -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CYHLocker.Web.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)
</head>

<body style="background:#080c18; color:#e2e8f0;">

    <!-- ===================== NAVBAR ===================== -->
    <nav id="main-navbar"
         class="fixed top-0 left-0 right-0 z-50 w-full px-4 py-3"
         style="background: transparent;">

        <div class="max-w-7xl mx-auto flex items-center justify-between">

            <!-- Logo -->
            <a asp-controller="Home" asp-action="Index"
               class="flex items-center gap-2 text-xl font-bold no-underline"
               style="color:#06b6d4; letter-spacing:-0.5px;">
                <span style="font-size:1.4rem;">🔒</span>
                <span>CYH<span style="color:#a78bfa;">Locker</span></span>
            </a>

            <!-- Desktop Nav Links (center) — only for logged-out landing -->
            @if (User.Identity?.IsAuthenticated != true)
            {
                <ul class="hidden md:flex items-center gap-6 list-none m-0 p-0">
                    <li><a href="#features" class="footer-link" style="color:#cbd5e1; font-size:0.9rem; display:inline;">Features</a></li>
                    <li><a href="#security" class="footer-link" style="color:#cbd5e1; font-size:0.9rem; display:inline;">Security</a></li>
                    <li><a href="#footer"   class="footer-link" style="color:#cbd5e1; font-size:0.9rem; display:inline;">About</a></li>
                </ul>
            }

            <!-- Right Side Buttons -->
            <div class="flex items-center gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var isAdmin = User.IsInRole("Admin");
                    var dashboardArea = isAdmin ? "Admin" : "User";
                    <a asp-area="@dashboardArea" asp-controller="Dashboard" asp-action="Index"
                       class="btn btn-sm btn-outline-glow hidden sm:inline-block">
                        📊 Dashboard
                    </a>
                    <div class="dropdown">
                        <button class="btn btn-sm dropdown-toggle"
                                style="background:rgba(139,92,246,0.15); border:1px solid rgba(139,92,246,0.4); color:#c4b5fd; border-radius:8px;"
                                data-bs-toggle="dropdown">
                            👤 @User.Identity.Name
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" style="background:#0f1629; border:1px solid rgba(139,92,246,0.3);">
                            <li><a class="dropdown-item" style="color:#e2e8f0;" asp-area="@dashboardArea" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                            <li><a class="dropdown-item" style="color:#e2e8f0;" asp-area="" asp-controller="Account" asp-action="Profile">Profile &amp; Settings</a></li>
                            <li><a class="dropdown-item" style="color:#e2e8f0;" asp-area="" asp-controller="Account" asp-action="ChangePassword">Change Password</a></li>
                            <li><hr class="dropdown-divider" style="border-color:rgba(255,255,255,0.1);"></li>
                            <li>
                                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" id="logoutForm">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item" style="color:#f87171;">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login"
                       class="hidden sm:inline-block"
                       style="color:#a78bfa; font-size:0.9rem; text-decoration:none; font-weight:500;">
                        Sign in
                    </a>
                    <a asp-controller="Auth" asp-action="Register"
                       class="btn btn-sm btn-glow"
                       style="border-radius:8px; padding: 6px 18px;">
                        Get Started
                    </a>
                }

                <!-- Mobile hamburger -->
                <button class="md:hidden btn btn-sm"
                        style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); color:#e2e8f0;"
                        data-bs-toggle="collapse" data-bs-target="#mobileMenu">
                    ☰
                </button>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div class="collapse md:hidden" id="mobileMenu">
            <div class="max-w-7xl mx-auto mt-3 pb-3 border-t" style="border-color:rgba(255,255,255,0.08);">
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a href="#features" class="block py-2 px-2 footer-link">Features</a>
                    <a href="#security" class="block py-2 px-2 footer-link">Security</a>
                    <a href="#footer"   class="block py-2 px-2 footer-link">About</a>
                    <div class="mt-3 flex gap-2">
                        <a asp-controller="Auth" asp-action="Login"
                           class="btn btn-sm btn-outline-glow">Login</a>
                        <a asp-controller="Auth" asp-action="Register"
                           class="btn btn-sm btn-glow">Sign Up Free</a>
                    </div>
                }
                else
                {
                    var isAdmin = User.IsInRole("Admin");
                    var dashboardArea = isAdmin ? "Admin" : "User";
                    <a asp-area="@dashboardArea" asp-controller="Dashboard" asp-action="Index" class="block py-2 px-2 footer-link">📊 Dashboard</a>
                    <a asp-area="" asp-controller="Account" asp-action="Profile" class="block py-2 px-2 footer-link">👤 My Account</a>
                    <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="block py-2 px-2 text-danger bg-transparent border-0">🚪 Logout</button>
                    </form>
                }
            </div>
        </div>
    </nav>
    <!-- =================== END NAVBAR =================== -->


    <!-- Flash Messages (shown on all pages) -->
    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="fixed top-20 right-4 z-50 flex flex-col gap-2" style="max-width:340px;">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow" role="alert" style="border-radius:12px;">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow" role="alert" style="border-radius:12px;">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
    }

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>


    <!-- ===================== FOOTER ===================== -->
    <footer class="landing-footer" id="footer">
        <div class="max-w-7xl mx-auto px-6 pt-16 pb-8">

            <!-- Top Row: 4 columns -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">

                <!-- Col 1: Brand -->
                <div>
                    <div class="flex items-center gap-2 mb-3">
                        <span style="font-size:1.3rem;">🔒</span>
                        <span class="text-lg font-bold" style="color:#06b6d4;">CYH<span style="color:#a78bfa;">Locker</span></span>
                    </div>
                    <p class="text-sm mb-4" style="color:#64748b; line-height:1.7;">
                        Your digital life, locked and protected. Built for individuals and teams who take security seriously.
                    </p>
                    <!-- Social Icons -->
                    <div class="flex gap-2">
                        <a href="#" class="footer-social" title="Twitter/X">𝕏</a>
                        <a href="#" class="footer-social" title="GitHub">⌥</a>
                        <a href="#" class="footer-social" title="Discord">◈</a>
                        <a href="#" class="footer-social" title="LinkedIn">in</a>
                    </div>
                </div>

                <!-- Col 2: Product -->
                <div>
                    <h6 class="font-semibold mb-4" style="color:#e2e8f0; font-size:0.85rem; text-transform:uppercase; letter-spacing:1px;">Product</h6>
                    <a href="#features"  class="footer-link">Features</a>
                    <a href="#"          class="footer-link">Pricing</a>
                    <a href="#"          class="footer-link">Security Audit</a>
                    <a href="#"          class="footer-link">Browser Extension</a>
                    <a href="#"          class="footer-link">Mobile App</a>
                    <a href="#"          class="footer-link">Changelog</a>
                </div>

                <!-- Col 3: Resources -->
                <div>
                    <h6 class="font-semibold mb-4" style="color:#e2e8f0; font-size:0.85rem; text-transform:uppercase; letter-spacing:1px;">Resources</h6>
                    <a href="#" class="footer-link">Documentation</a>
                    <a href="#" class="footer-link">API Reference</a>
                    <a href="#" class="footer-link">Security Whitepaper</a>
                    <a href="#" class="footer-link">Blog &amp; Tutorials</a>
                    <a href="#" class="footer-link">Community Forum</a>
                    <a href="#" class="footer-link">Status Page</a>
                </div>

                <!-- Col 4: Company -->
                <div>
                    <h6 class="font-semibold mb-4" style="color:#e2e8f0; font-size:0.85rem; text-transform:uppercase; letter-spacing:1px;">Company</h6>
                    <a href="#" class="footer-link">About Us</a>
                    <a href="#" class="footer-link">Careers</a>
                    <a href="#" class="footer-link">Press Kit</a>
                    <a asp-controller="Home" asp-action="Privacy" class="footer-link">Privacy Policy</a>
                    <a href="#" class="footer-link">Terms of Service</a>
                    <a href="#" class="footer-link">Contact Us</a>
                </div>
            </div>

            <!-- Divider -->
            <div style="border-top:1px solid rgba(255,255,255,0.06); margin-bottom:1.5rem;"></div>

            <!-- Bottom Bar -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                <p class="text-sm m-0" style="color:#475569;">
                    &copy; 2026 CYHLocker Technologies. All rights reserved.
                </p>
                <div class="flex flex-wrap gap-2 justify-center">
                    <span class="compliance-badge">🔒 SOC 2 Compliant</span>
                    <span class="compliance-badge">🛡️ ISO 27001</span>
                    <span class="compliance-badge">✅ GDPR Ready</span>
                    <span class="compliance-badge">🔐 AES-256</span>
                </div>
            </div>
        </div>
    </footer>
    <!-- =================== END FOOTER =================== -->


    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Navbar scroll effect -->
    <script>
        const nav = document.getElementById('main-navbar');
        window.addEventListener('scroll', () => {
            nav.classList.toggle('scrolled', window.scrollY > 30);
        });

        // Fade-up animation on scroll
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
        }, { threshold: 0.1 });
        document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
    </script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Auto-lock: 15 min inactivity -->
        <script>
            (function () {
                var TIMEOUT_MS = 15 * 60 * 1000;
                var timer, warningTimer;
                function resetTimer() {
                    clearTimeout(timer); clearTimeout(warningTimer);
                    warningTimer = setTimeout(function () {
                        if (confirm('Session will expire in 1 minute. Click OK to stay logged in.'))
                            resetTimer();
                    }, TIMEOUT_MS - 60000);
                    timer = setTimeout(function () {
                        document.getElementById('logoutForm')?.submit();
                    }, TIMEOUT_MS);
                }
                ['mousemove','keypress','scroll','click','touchstart'].forEach(function(e){
                    document.addEventListener(e, resetTimer, { passive: true });
                });
                resetTimer();
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
