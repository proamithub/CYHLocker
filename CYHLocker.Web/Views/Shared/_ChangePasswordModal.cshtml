<!-- ==========================================================================
     GLOBAL CHANGE PASSWORD MODAL POPUP
     ========================================================================== -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 490px; margin: 1.5rem auto;">
        <div class="modal-content glass-card" style="background:#0b1120; border:1px solid rgba(6,182,212,0.35); box-shadow:0 25px 60px rgba(0,0,0,0.85); border-radius:18px; color:#fff; overflow:hidden;">
            
            <!-- Modal Header -->
            <div class="modal-header border-bottom border-secondary border-opacity-25 py-3 px-4" style="background:rgba(15,23,42,0.98);">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:42px; height:42px; border-radius:10px; background:rgba(6,182,212,0.15); border:1px solid rgba(6,182,212,0.4); display:flex; align-items:center; justify-content:center; font-size:1.35rem; box-shadow:0 0 15px rgba(6,182,212,0.25);">
                        🔑
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold m-0 text-light" id="changePasswordModalLabel" style="font-size:1.15rem;">Change Master Password</h5>
                        <p class="text-secondary small m-0" style="font-size:0.75rem;">Update your CYHLocker account master credentials</p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Form -->
            <form id="changePasswordModalForm" method="post" action="/Account/ChangePassword" autocomplete="off">
                @Html.AntiForgeryToken()
                
                <div class="modal-body px-4 py-3">
                    
                    <!-- Alert Status Container -->
                    <div id="cpModalAlert" class="alert py-2 px-3 small mb-3" style="display:none; border-radius:10px; font-size:0.82rem;"></div>

                    <!-- Security Info Notice -->
                    <div class="p-2 mb-3 rounded-2 d-flex align-items-center gap-2" style="background:rgba(6,182,212,0.06); border:1px solid rgba(6,182,212,0.2);">
                        <span style="font-size:1.15rem;">🛡️</span>
                        <span class="text-secondary small" style="font-size:0.75rem; line-height:1.35;">
                            Changing your master password updates your encryption key access. Ensure your new password is at least 8 characters.
                        </span>
                    </div>

                    <!-- 1. Current Password -->
                    <div class="mb-3">
                        <label for="cpCurrentPassword" class="form-label small text-light fw-semibold mb-1">
                            Current Master Password <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input type="password" id="cpCurrentPassword" name="CurrentPassword" required 
                                   class="form-control auth-input" 
                                   placeholder="Enter current password" 
                                   style="background:rgba(15,23,42,0.9); border:1px solid rgba(6,182,212,0.25); border-right:none; color:#fff; border-radius:8px 0 0 8px; font-size:0.88rem; padding:9px 12px;"
                                   autocomplete="current-password" />
                            <button class="btn btn-outline-secondary" type="button" 
                                    onclick="toggleCpVisibility('cpCurrentPassword', this)" 
                                    style="background:rgba(15,23,42,0.9); border:1px solid rgba(6,182,212,0.25); border-left:none; border-radius:0 8px 8px 0; color:#94a3b8; font-size:0.85rem;" 
                                    title="Show/Hide Password">
                                👁️
                            </button>
                        </div>
                    </div>

                    <!-- 2. New Password -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="cpNewPassword" class="form-label small text-light fw-semibold mb-0">
                                New Master Password <span class="text-danger">*</span>
                            </label>
                            <span class="text-secondary small" style="font-size:0.72rem;">Min. 8 characters</span>
                        </div>
                        <div class="input-group">
                            <input type="password" id="cpNewPassword" name="NewPassword" required 
                                   class="form-control auth-input" 
                                   placeholder="Create new master password" 
                                   style="background:rgba(15,23,42,0.9); border:1px solid rgba(6,182,212,0.25); border-right:none; color:#fff; border-radius:8px 0 0 8px; font-size:0.88rem; padding:9px 12px;"
                                   autocomplete="new-password" 
                                   oninput="evaluateCpStrength(this.value); checkCpMatch();" />
                            <button class="btn btn-outline-secondary" type="button" 
                                    onclick="toggleCpVisibility('cpNewPassword', this)" 
                                    style="background:rgba(15,23,42,0.9); border:1px solid rgba(6,182,212,0.25); border-left:none; border-radius:0 8px 8px 0; color:#94a3b8; font-size:0.85rem;" 
                                    title="Show/Hide Password">
                                👁️
                            </button>
                        </div>

                        <!-- Password Strength Meter -->
                        <div class="mt-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-secondary" style="font-size:0.7rem;">Password Strength:</span>
                                <span id="cpStrengthLabel" class="fw-semibold" style="font-size:0.72rem; color:#94a3b8;">Not entered</span>
                            </div>
                            <div class="progress" style="height:4px; background:rgba(255,255,255,0.08); border-radius:2px;">
                                <div id="cpStrengthProgressBar" class="progress-bar" role="progressbar" style="width:0%; transition:all 0.3s;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Confirm New Password -->
                    <div class="mb-2">
                        <label for="cpConfirmPassword" class="form-label small text-light fw-semibold mb-1">
                            Confirm New Password <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input type="password" id="cpConfirmPassword" name="ConfirmPassword" required 
                                   class="form-control auth-input" 
                                   placeholder="Re-type new master password" 
                                   style="background:rgba(15,23,42,0.9); border:1px solid rgba(6,182,212,0.25); border-right:none; color:#fff; border-radius:8px 0 0 8px; font-size:0.88rem; padding:9px 12px;"
                                   autocomplete="new-password" 
                                   oninput="checkCpMatch();" />
                            <button class="btn btn-outline-secondary" type="button" 
                                    onclick="toggleCpVisibility('cpConfirmPassword', this)" 
                                    style="background:rgba(15,23,42,0.9); border:1px solid rgba(6,182,212,0.25); border-left:none; border-radius:0 8px 8px 0; color:#94a3b8; font-size:0.85rem;" 
                                    title="Show/Hide Password">
                                👁️
                            </button>
                        </div>
                        <div id="cpMatchFeedback" class="small mt-1" style="font-size:0.75rem; display:none;"></div>
                    </div>

                </div>

                <!-- Modal Footer -->
                <div class="modal-footer border-top border-secondary border-opacity-25 py-3 px-4 d-flex justify-content-between" style="background:rgba(10,15,30,0.98);">
                    <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal" style="font-size:0.85rem; border-radius:8px;">
                        Cancel
                    </button>
                    <button type="submit" id="btnSubmitChangePassword" class="btn btn-glow btn-sm px-4 py-2" style="font-size:0.85rem; border-radius:8px;">
                        🔑 Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function toggleCpVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        if (!input) return;
        if (input.type === 'password') {
            input.type = 'text';
            btn.innerHTML = '🙈';
        } else {
            input.type = 'password';
            btn.innerHTML = '👁️';
        }
    }

    function evaluateCpStrength(password) {
        const bar = document.getElementById('cpStrengthProgressBar');
        const label = document.getElementById('cpStrengthLabel');
        if (!bar || !label) return;

        if (!password) {
            bar.style.width = '0%';
            bar.className = 'progress-bar';
            label.textContent = 'Not entered';
            label.style.color = '#94a3b8';
            return;
        }

        let score = 0;
        if (password.length >= 8) score++;
        if (password.length >= 12) score++;
        if (/[A-Z]/.test(password) && /[a-z]/.test(password)) score++;
        if (/[0-9]/.test(password)) score++;
        if (/[^A-Za-z0-9]/.test(password)) score++;

        if (score <= 1) {
            bar.style.width = '25%';
            bar.style.backgroundColor = '#ef4444';
            label.textContent = 'Weak';
            label.style.color = '#ef4444';
        } else if (score <= 2) {
            bar.style.width = '50%';
            bar.style.backgroundColor = '#f59e0b';
            label.textContent = 'Fair';
            label.style.color = '#f59e0b';
        } else if (score <= 3) {
            bar.style.width = '75%';
            bar.style.backgroundColor = '#3b82f6';
            label.textContent = 'Good';
            label.style.color = '#3b82f6';
        } else {
            bar.style.width = '100%';
            bar.style.backgroundColor = '#10b981';
            label.textContent = 'Strong 🛡️';
            label.style.color = '#10b981';
        }
    }

    function checkCpMatch() {
        const newPass = document.getElementById('cpNewPassword')?.value || '';
        const confirmPass = document.getElementById('cpConfirmPassword')?.value || '';
        const feedback = document.getElementById('cpMatchFeedback');
        if (!feedback) return;

        if (!confirmPass) {
            feedback.style.display = 'none';
            return;
        }

        feedback.style.display = 'block';
        if (newPass === confirmPass) {
            feedback.style.color = '#34d399';
            feedback.innerHTML = '✓ Passwords match';
        } else {
            feedback.style.color = '#f87171';
            feedback.innerHTML = '✕ Passwords do not match';
        }
    }

    function showCpAlert(msg, type) {
        const alertBox = document.getElementById('cpModalAlert');
        if (!alertBox) return;

        alertBox.className = `alert py-2 px-3 small mb-3 alert-${type}`;
        if (type === 'danger') {
            alertBox.style.backgroundColor = 'rgba(239, 68, 68, 0.12)';
            alertBox.style.borderColor = 'rgba(239, 68, 68, 0.35)';
            alertBox.style.color = '#fca5a5';
        } else if (type === 'warning') {
            alertBox.style.backgroundColor = 'rgba(245, 158, 11, 0.12)';
            alertBox.style.borderColor = 'rgba(245, 158, 11, 0.35)';
            alertBox.style.color = '#fcd34d';
        } else if (type === 'success') {
            alertBox.style.backgroundColor = 'rgba(16, 185, 129, 0.12)';
            alertBox.style.borderColor = 'rgba(16, 185, 129, 0.35)';
            alertBox.style.color = '#6ee7b7';
        }
        alertBox.innerHTML = msg;
        alertBox.style.display = 'block';
    }

    window.openChangePasswordModal = function() {
        const modalEl = document.getElementById('changePasswordModal');
        if (!modalEl) {
            window.location.href = '/Account/ChangePassword';
            return;
        }

        // Reset form
        const form = document.getElementById('changePasswordModalForm');
        if (form) form.reset();

        const alertBox = document.getElementById('cpModalAlert');
        if (alertBox) alertBox.style.display = 'none';

        evaluateCpStrength('');
        checkCpMatch();

        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();

        setTimeout(() => {
            document.getElementById('cpCurrentPassword')?.focus();
        }, 300);
    };

    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('changePasswordModalForm');
        if (form) {
            form.addEventListener('submit', async function(e) {
                e.preventDefault();
                const alertBox = document.getElementById('cpModalAlert');
                if (alertBox) alertBox.style.display = 'none';

                const currentPass = document.getElementById('cpCurrentPassword')?.value?.trim();
                const newPass = document.getElementById('cpNewPassword')?.value;
                const confirmPass = document.getElementById('cpConfirmPassword')?.value;

                if (!currentPass) {
                    showCpAlert('⚠️ Please enter your current master password.', 'danger');
                    return;
                }
                if (!newPass || newPass.length < 8) {
                    showCpAlert('⚠️ New password must be at least 8 characters long.', 'danger');
                    return;
                }
                if (newPass !== confirmPass) {
                    showCpAlert('⚠️ New password and confirmation password do not match.', 'danger');
                    return;
                }
                if (currentPass === newPass) {
                    showCpAlert('⚠️ New password cannot be identical to your current password.', 'warning');
                    return;
                }

                const btnSubmit = document.getElementById('btnSubmitChangePassword');
                const origHtml = btnSubmit.innerHTML;
                btnSubmit.disabled = true;
                btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Updating...';

                try {
                    const formData = new FormData(form);
                    const response = await fetch('/Account/ChangePassword', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const contentType = response.headers.get('content-type') || '';
                    if (contentType.includes('application/json')) {
                        const data = await response.json();
                        if (data.success) {
                            showCpAlert('✅ ' + (data.message || 'Password changed successfully!'), 'success');
                            form.reset();
                            evaluateCpStrength('');
                            checkCpMatch();
                            setTimeout(() => {
                                const modalEl = document.getElementById('changePasswordModal');
                                if (modalEl) {
                                    const modal = bootstrap.Modal.getInstance(modalEl);
                                    if (modal) modal.hide();
                                }
                            }, 1500);
                        } else {
                            showCpAlert('✕ ' + (data.message || 'Failed to update password.'), 'danger');
                        }
                    } else {
                        // In case server returned HTML (redirect or view)
                        const html = await response.text();
                        if (response.redirected || response.url.includes('/Profile') || html.includes('Profile updated') || html.includes('Password changed')) {
                            showCpAlert('✅ Password changed successfully!', 'success');
                            form.reset();
                            evaluateCpStrength('');
                            checkCpMatch();
                            setTimeout(() => {
                                const modalEl = document.getElementById('changePasswordModal');
                                if (modalEl) {
                                    const modal = bootstrap.Modal.getInstance(modalEl);
                                    if (modal) modal.hide();
                                }
                            }, 1500);
                        } else {
                            const parser = new DOMParser();
                            const doc = parser.parseFromString(html, 'text/html');
                            const errEl = doc.querySelector('.validation-summary-errors, .text-danger');
                            const msg = errEl ? errEl.innerText.trim() : 'Current password incorrect or validation failed.';
                            showCpAlert('✕ ' + msg, 'danger');
                        }
                    }
                } catch (err) {
                    console.error('Password change error:', err);
                    showCpAlert('✕ Network error. Please try again.', 'danger');
                } finally {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = origHtml;
                }
            });
        }

        // Auto-open modal if URL has openChangePassword=1 or changePassword=1
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('openChangePassword') === '1' || urlParams.get('changePassword') === '1' || urlParams.get('changePassword') === 'true') {
            window.openChangePasswordModal();
            // Clean URL query parameter without refresh
            urlParams.delete('openChangePassword');
            urlParams.delete('changePassword');
            const cleanUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '') + window.location.hash;
            window.history.replaceState({}, document.title, cleanUrl);
        }
    });
</script>