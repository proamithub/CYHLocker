@using System.Security.Claims
@{
    ViewData["Title"] = "Dashboard";
    var userName = User.Identity?.Name ?? "User";
    var email    = User.FindFirst(ClaimTypes.Email)?.Value ?? "";
    var role     = User.FindFirst(ClaimTypes.Role)?.Value ?? "User";
    var isMfa    = User.Claims.Any(c => c.Type == "mfa_enabled" && c.Value == "true");
}

<div class="max-w-5xl mx-auto px-4 py-5" style="padding-top: 100px !important;">

    <!-- Welcome Header -->
    <div class="d-flex justify-content-between align-items-start align-items-sm-center mb-5 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1" style="color:#f1f5f9;">👋 Welcome back, @userName!</h2>
            <p class="m-0 small">
                <span style="color:#64748b;">@email</span>
                &nbsp;
                <span class="badge" style="background:rgba(139,92,246,0.2); color:#c4b5fd; border:1px solid rgba(139,92,246,0.3);">@role</span>
            </p>
        </div>
        <div class="trust-badge">
            <span style="width:7px;height:7px;border-radius:50%;background:#10b981;display:inline-block;"></span>
            Session Active
        </div>
    </div>

    <!-- Dashboard Cards -->
    <div class="row g-4 mb-4">

        <!-- Change Password -->
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="glass-card p-4 h-100 text-center">
                <div style="font-size:2.5rem;" class="mb-3">🔑</div>
                <h5 class="fw-semibold mb-2" style="color:#e2e8f0;">Change Password</h5>
                <p class="small mb-3" style="color:#64748b;">Update your account password securely anytime.</p>
                <a asp-controller="Account" asp-action="ChangePassword"
                   class="btn btn-sm btn-outline-glow">Change Password</a>
            </div>
        </div>

        <!-- Two-Factor Auth -->
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="glass-card p-4 h-100 text-center">
                <div style="font-size:2.5rem;" class="mb-3">📱</div>
                <h5 class="fw-semibold mb-2" style="color:#e2e8f0;">Two-Factor Auth</h5>
                <p class="small mb-3" style="color:#64748b;">
                    @(isMfa ? "MFA is active on your account." : "Add an extra layer of security.")
                </p>
                @if (isMfa)
                {
                    <span class="badge" style="background:rgba(16,185,129,0.15); color:#34d399; border:1px solid rgba(16,185,129,0.3); padding:6px 14px; border-radius:8px;">
                        ✅ MFA Active
                    </span>
                }
                else
                {
                    <a asp-controller="Account" asp-action="SetupMfa"
                       class="btn btn-sm btn-outline-glow">Enable MFA</a>
                }
            </div>
        </div>

        <!-- Active Sessions -->
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="glass-card p-4 h-100 text-center">
                <div style="font-size:2.5rem;" class="mb-3">🖥️</div>
                <h5 class="fw-semibold mb-2" style="color:#e2e8f0;">Active Sessions</h5>
                <p class="small mb-3" style="color:#64748b;">View and manage your logged-in devices.</p>
                <a asp-controller="Account" asp-action="Profile"
                   class="btn btn-sm btn-outline-glow">Manage Sessions</a>
            </div>
        </div>
    </div>

    <!-- Phase Info Bar -->
    <div class="glass-card p-3" style="border-color:rgba(16,185,129,0.2);">
        <small style="color:#34d399;">
            ✅ <strong>CYHLocker Phase 1 Complete</strong> —
            BCrypt hashing, Account Lockout, MFA/TOTP, Sessions,
            Forgot Password, Auto-lock, Change Password — all wired via
            Stored Procedures on <strong>AmitLab → CYHLockerDB</strong>
        </small>
    </div>
</div>
