@{
    ViewData["Title"] = "My Dashboard";
}

<!-- ========================================================
     User Dashboard (Areas/User)
     ======================================================== -->

<!-- Welcome Banner -->
<div class="user-welcome-banner mb-4">
    <div>
        <h2 class="user-welcome-title">👋 Welcome back, @ViewBag.UserName!</h2>
        <p class="user-welcome-sub">@ViewBag.UserEmail</p>
    </div>
    <div class="user-session-badge">
        <span class="user-dot"></span>
        Session Active
    </div>
</div>

<!-- Quick Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="user-stat-card">
            <div class="user-stat-icon teal">🔐</div>
            <div class="user-stat-num">0</div>
            <div class="user-stat-lbl">Saved Passwords</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="user-stat-card">
            <div class="user-stat-icon green">✅</div>
            <div class="user-stat-num">@(ViewBag.IsMfa == true ? "Active" : "Ready")</div>
            <div class="user-stat-lbl">MFA Protection</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="user-stat-card">
            <div class="user-stat-icon purple">🖥️</div>
            <div class="user-stat-num">1</div>
            <div class="user-stat-lbl">Current Device</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="user-stat-card">
            <div class="user-stat-icon amber">🛡️</div>
            <div class="user-stat-num">AES-256</div>
            <div class="user-stat-lbl">Vault Security</div>
        </div>
    </div>
</div>

<!-- Action Cards -->
<div class="row g-4 mb-4">

    <!-- My Vault -->
    <div class="col-12 col-sm-6 col-lg-4">
        <div class="user-card h-100">
            <div class="user-card-icon">🔐</div>
            <h5 class="user-card-title">My Vault</h5>
            <p class="user-card-desc">Store, view, and manage all your saved passwords securely.</p>
            <a asp-area="User" asp-controller="Vault" asp-action="Index" class="user-btn-primary">Open Vault →</a>
        </div>
    </div>

    <!-- Security -->
    <div class="col-12 col-sm-6 col-lg-4">
        <div class="user-card h-100">
            <div class="user-card-icon">🛡️</div>
            <h5 class="user-card-title">Security</h5>
            <p class="user-card-desc">Manage 2FA, view active sessions, and review login activity.</p>
            <a asp-area="User" asp-controller="Security" asp-action="Index" class="user-btn-primary">Security Settings →</a>
        </div>
    </div>

    <!-- Profile -->
    <div class="col-12 col-sm-6 col-lg-4">
        <div class="user-card h-100">
            <div class="user-card-icon">👤</div>
            <h5 class="user-card-title">My Profile</h5>
            <p class="user-card-desc">Update your name, email preferences and account details.</p>
            <a asp-area="" asp-controller="Account" asp-action="Profile" class="user-btn-primary">Edit Profile →</a>
        </div>
    </div>
</div>

<!-- MFA Alert -->
@if (ViewBag.IsMfa != true)
{
    <div class="user-alert-warn">
        <span>⚠️</span>
        <div>
            <strong>Enhance your security!</strong> You haven't enabled Multi-Factor Authentication yet.
            <a asp-area="" asp-controller="Account" asp-action="SetupMfa" style="color:#fbbf24; text-decoration:underline; font-weight:600;">Enable MFA now →</a>
        </div>
    </div>
}
else
{
    <div class="user-alert-success">
        <span>✅</span>
        <div>
            <strong>Account Protected!</strong> Multi-Factor Authentication (TOTP) is active on your vault.
        </div>
    </div>
}
