@model List<CYHLocker.Data.DTOs.VaultItemDto>
@{
    ViewData["Title"] = "Trash & Recycle Bin";
    var counts = ViewBag.Counts as CYHLocker.Data.DTOs.VaultSidebarCountsDto ?? new();
}

<div class="container py-4" style="max-width:980px;">

    <!-- Top Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="mb-2">
                <a asp-area="User" asp-controller="Vault" asp-action="Index" class="btn btn-sm btn-outline-secondary" style="border-radius:10px;">
                    ← Back to Active Vault
                </a>
            </div>
            <h2 class="user-welcome-title mb-1 text-danger">🗑️ Trash & Recycle Bin</h2>
            <p class="user-welcome-sub">Deleted items remain safely recoverable until you permanently erase them</p>
        </div>
        @if (Model.Count > 0)
        {
            <form method="post" asp-area="User" asp-controller="Vault" asp-action="EmptyTrash" onsubmit="return confirm('WARNING: Are you sure you want to permanently erase ALL items in Trash? This action CANNOT be undone.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger d-inline-flex align-items-center gap-2" style="border-radius:12px; font-weight:600;">
                    💥 Empty Entire Trash (@Model.Count)
                </button>
            </form>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="glass-card text-center py-5 p-4" style="border: 2px dashed rgba(239, 68, 68, 0.25); border-radius:18px;">
            <div style="font-size:3.5rem;" class="mb-3">✨</div>
            <h4 class="fw-bold text-light mb-2">Trash is Empty</h4>
            <p class="text-muted small mx-auto mb-4" style="max-width:440px;">
                You don't have any deleted items. Items moved to trash will appear here where you can restore them anytime.
            </p>
            <a asp-area="User" asp-controller="Vault" asp-action="Index" class="btn btn-glow">
                Go to Vault
            </a>
        </div>
    }
    else
    {
        <div class="glass-card p-3" style="border-radius:18px; border-color:rgba(239, 68, 68, 0.25); background:rgba(15,23,42,0.8);">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle" style="background:transparent;">
                    <thead>
                        <tr style="border-bottom:1px solid rgba(239,68,68,0.25); font-size:0.85rem; color:#94a3b8;">
                            <th>Item</th>
                            <th>Type</th>
                            <th>Subtitle / Info</th>
                            <th>Deleted Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="vault-brand-avatar" style="width:36px; height:36px; font-size:1.2rem;">
                                            @if (!string.IsNullOrEmpty(item.ItemIcon) && item.ItemIcon.StartsWith("http"))
                                            {
                                                <img src="@item.ItemIcon" alt="@item.Title" style="width:22px; height:22px; object-fit:contain;" />
                                            }
                                            else
                                            {
                                                <span>@(string.IsNullOrEmpty(item.ItemIcon) ? "🌐" : item.ItemIcon)</span>
                                            }
                                        </div>
                                        <span class="fw-semibold text-light">@item.Title</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="vault-type-badge @(item.ItemType.ToLower())">
                                        @item.ItemType
                                    </span>
                                </td>
                                <td>
                                    <span class="small text-muted">
                                        @(string.IsNullOrEmpty(item.SecondaryInfo) ? "—" : item.SecondaryInfo)
                                    </span>
                                </td>
                                <td>
                                    <span class="small text-muted">
                                        @item.UpdatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <!-- Restore Form -->
                                        <form method="post" asp-area="User" asp-controller="Vault" asp-action="Restore" asp-route-id="@item.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success py-1 px-3" style="border-radius:8px;" title="Restore back to vault">
                                                ↩️ Restore
                                            </button>
                                        </form>

                                        <!-- Permanent Delete Form -->
                                        <form method="post" asp-area="User" asp-controller="Vault" asp-action="PermanentDelete" asp-route-id="@item.Id" onsubmit="return confirm('Permanently erase this item? This CANNOT be undone.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-3" style="border-radius:8px;" title="Permanently erase">
                                                ❌ Erase
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
