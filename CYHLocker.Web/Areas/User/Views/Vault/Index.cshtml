    // ==========================================================================
    // FOLDER & CATEGORY ICON PICKER LOGIC (PRESETS + CUSTOM IMAGES + CROP/COMPRESS)
    // ==========================================================================
    function renderIconHtml(icon, size = 24) {
        if (!icon) return '📁';
        if (icon.startsWith('http') || icon.startsWith('data:image') || icon.startsWith('/uploads/')) {
            return `<img src="${icon}" alt="icon" style="width:${size}px; height:${size}px; object-fit:cover; border-radius:4px; display:inline-block; vertical-align:middle;" />`;
        }
        return `<span>${icon}</span>`;
    }

    function getCustomFolderIcons() {
        let list = [];
        try {
            const raw = localStorage.getItem('cyh_custom_folder_icons');
            if (raw) {
                const parsed = JSON.parse(raw);
                if (Array.isArray(parsed)) list = parsed;
            }
        } catch (e) {
            console.error('Error reading custom icons:', e);
        }

        // Dynamically include any custom icons saved in existing server categories
        if (window.EXISTING_CATEGORIES && Array.isArray(window.EXISTING_CATEGORIES)) {
            window.EXISTING_CATEGORIES.forEach(c => {
                const icon = c.Icon || c.icon;
                if (icon && (icon.startsWith('http') || icon.startsWith('data:image') || icon.startsWith('/uploads/'))) {
                    if (!list.includes(icon)) {
                        list.push(icon);
                    }
                }
            });
        }
        return list;
    }

    function saveCustomFolderIcons(icons) {
        try {
            localStorage.setItem('cyh_custom_folder_icons', JSON.stringify(icons));
        } catch (e) {
            console.error('Error saving custom icons:', e);
        }
        updateCustomIconCount();
    }

    function updateCustomIconCount() {
        const count = getCustomFolderIcons().length;
        document.querySelectorAll('.custom-icon-count').forEach(el => {
            el.textContent = count;
        });
    }

    // --- INTERACTIVE 1:1 SQUARE IMAGE CROPPER & COMPRESSOR ---
    const cropperStates = {
        create: { img: null, scale: 1, panX: 0, panY: 0, isDragging: false, startX: 0, startY: 0, initialized: false },
        edit:   { img: null, scale: 1, panX: 0, panY: 0, isDragging: false, startX: 0, startY: 0, initialized: false }
    };

    function handleImageFileSelected(input, mode) {
        if (!input.files || !input.files[0]) return;
        const file = input.files[0];
        const reader = new FileReader();
        reader.onload = function(e) {
            loadCropperImage(mode, e.target.result);
        };
        reader.readAsDataURL(file);
        input.value = '';
    }

    function handleImageUrlLoad(mode) {
        const input = document.getElementById(mode === 'edit' ? 'editImgUrlInput' : 'catImgUrlInput');
        const url = (input?.value || '').trim();
        if (!url) {
            alert('Kripya pehle image ka link paste karein.');
            return;
        }
        loadCropperImage(mode, url);
    }

    function loadCropperImage(mode, src) {
        const img = new Image();
        img.crossOrigin = 'Anonymous';
        img.onload = function() {
            openCropper(mode, img);
        };
        img.onerror = function() {
            alert('⚠️ Image load nahi ho payi!\n\nTip: Agar kisi external website ne direct link access block kar rakha hai, to image par Right-Click karke "Save image as" karein aur "Upload Image" button se crop karein.');
        };
        img.src = src;
    }

    function openCropper(mode, img) {
        const state = cropperStates[mode];
        state.img = img;
        state.scale = 1;
        state.panX = 0;
        state.panY = 0;

        const zoomSlider = document.getElementById(mode === 'edit' ? 'editZoomSlider' : 'createZoomSlider');
        if (zoomSlider) zoomSlider.value = 1;

        const box = document.getElementById(mode === 'edit' ? 'editCropperBox' : 'createCropperBox');
        if (box) box.style.display = 'block';

        if (!state.initialized) {
            setupCropperViewportEvents(mode);
            state.initialized = true;
        }

        drawCropper(mode);
    }

    function setupCropperViewportEvents(mode) {
        const viewport = document.getElementById(mode === 'edit' ? 'editCropViewport' : 'createCropViewport');
        if (!viewport) return;
        const state = cropperStates[mode];

        function onPointerDown(e) {
            state.isDragging = true;
            viewport.style.cursor = 'grabbing';
            const pageX = e.touches ? e.touches[0].pageX : e.pageX;
            const pageY = e.touches ? e.touches[0].pageY : e.pageY;
            state.startX = pageX - state.panX;
            state.startY = pageY - state.panY;
        }

        function onPointerMove(e) {
            if (!state.isDragging) return;
            const pageX = e.touches ? e.touches[0].pageX : e.pageX;
            const pageY = e.touches ? e.touches[0].pageY : e.pageY;
            state.panX = pageX - state.startX;
            state.panY = pageY - state.startY;
            drawCropper(mode);
        }

        function onPointerUp() {
            state.isDragging = false;
            viewport.style.cursor = 'grab';
        }

        viewport.addEventListener('mousedown', onPointerDown);
        window.addEventListener('mousemove', onPointerMove);
        window.addEventListener('mouseup', onPointerUp);

        viewport.addEventListener('touchstart', onPointerDown, { passive: true });
        window.addEventListener('touchmove', onPointerMove, { passive: true });
        window.addEventListener('touchend', onPointerUp);
    }

    function drawCropper(mode) {
        const state = cropperStates[mode];
        if (!state.img) return;

        const sourceCanvas = document.getElementById(mode === 'edit' ? 'editSourceCanvas' : 'createSourceCanvas');
        const previewCanvas = document.getElementById(mode === 'edit' ? 'editPreviewCanvas' : 'createPreviewCanvas');
        if (!sourceCanvas || !previewCanvas) return;

        const sCtx = sourceCanvas.getContext('2d');
        const pCtx = previewCanvas.getContext('2d');

        sCtx.clearRect(0, 0, 130, 130);
        pCtx.clearRect(0, 0, 48, 48);

        const img = state.img;
        const minDim = Math.min(img.width, img.height);
        const baseScale = (130 / minDim) * state.scale;

        const drawW = img.width * baseScale;
        const drawH = img.height * baseScale;
        const drawX = (130 - drawW) / 2 + state.panX;
        const drawY = (130 - drawH) / 2 + state.panY;

        // Draw on Source Viewport (130x130)
        sCtx.drawImage(img, drawX, drawY, drawW, drawH);

        // Draw downscaled to 48x48 on Preview Canvas
        pCtx.drawImage(sourceCanvas, 0, 0, 130, 130, 0, 0, 48, 48);
    }

    function onCropperZoom(mode, val) {
        cropperStates[mode].scale = parseFloat(val);
        drawCropper(mode);
    }

    function cancelCropper(mode) {
        const box = document.getElementById(mode === 'edit' ? 'editCropperBox' : 'createCropperBox');
        if (box) box.style.display = 'none';
        cropperStates[mode].img = null;
    }

    function applyCroppedIcon(mode) {
        const previewCanvas = document.getElementById(mode === 'edit' ? 'editPreviewCanvas' : 'createPreviewCanvas');
        if (!previewCanvas) return;

        // Create 64x64 export canvas for high-DPI crisp folder icon
        const exportCanvas = document.createElement('canvas');
        exportCanvas.width = 64;
        exportCanvas.height = 64;
        const expCtx = exportCanvas.getContext('2d');
        expCtx.drawImage(previewCanvas, 0, 0, 48, 48, 0, 0, 64, 64);

        // Compress to WebP / PNG
        let dataUrl = exportCanvas.toDataURL('image/webp', 0.85);
        if (!dataUrl || dataUrl.length < 50 || dataUrl.indexOf('data:image/webp') === -1) {
            dataUrl = exportCanvas.toDataURL('image/png');
        }

        // Save to custom icons list
        let customList = getCustomFolderIcons();
        if (!customList.includes(dataUrl)) {
            customList.unshift(dataUrl);
            saveCustomFolderIcons(customList);
        }

        // Repopulate both icon grids so newly cropped icon immediately exists as a selectable button!
        const currentCreateIcon = mode === 'create' ? dataUrl : (document.getElementById('catIconInput')?.value || '📁');
        const currentEditIcon = mode === 'edit' ? dataUrl : (document.getElementById('editCatIconInput')?.value || '📁');
        populateIconGrid('catIconGrid', currentCreateIcon, 'selectFolderIcon');
        populateIconGrid('editCatIconGrid', currentEditIcon, 'selectEditFolderIcon');

        // Auto-select newly cropped & compressed icon
        if (mode === 'edit') {
            selectEditFolderIcon(dataUrl);
        } else {
            selectFolderIcon(dataUrl);
        }

        // Close cropper box
        cancelCropper(mode);

        // Switch to custom tab
        const tabSelector = mode === 'edit' ? '.edit-cat-icon-tab[data-cat="custom"]' : '.cat-icon-tab[data-cat="custom"]';
        const customTab = document.querySelector(tabSelector);
        if (customTab) {
            filterIconTabs('custom', customTab, mode === 'edit' ? 'editCatIconGrid' : 'catIconGrid');
        }
    }

    // --- QUICK EMOJI ADD ---
    function quickAddCustomIcon(mode, emoji) {
        let customList = getCustomFolderIcons();
        if (!customList.includes(emoji)) {
            customList.unshift(emoji);
            saveCustomFolderIcons(customList);
        }

        const gridId = mode === 'edit' ? 'editCatIconGrid' : 'catIconGrid';
        const clickHandler = mode === 'edit' ? 'selectEditFolderIcon' : 'selectFolderIcon';

        populateIconGrid(gridId, emoji, clickHandler);
        if (mode === 'edit') {
            selectEditFolderIcon(emoji);
        } else {
            selectFolderIcon(emoji);
        }

        const tabSelector = mode === 'edit' ? '.edit-cat-icon-tab[data-cat="custom"]' : '.cat-icon-tab[data-cat="custom"]';
        const customTab = document.querySelector(tabSelector);
        if (customTab) {
            filterIconTabs('custom', customTab, gridId);
        }
    }

    function addCustomIconFromInput(mode) {
        const inputId = mode === 'edit' ? 'editCustomAddInput' : 'catCustomAddInput';
        const input = document.getElementById(inputId);
        if (!input) return;
        const raw = input.value.trim();
        if (!raw) return;

        quickAddCustomIcon(mode, raw);
        input.value = '';
    }

    // --- DELETE CUSTOM ICON (WITH IN-USE ALERT SHOWING HOW MANY PLACES USED) ---
    function deleteCustomFolderIcon(icon, event) {
        if (event) {
            event.stopPropagation();
            event.preventDefault();
        }

        // Check how many existing folders are using this exact icon
        const usedFolders = (window.EXISTING_CATEGORIES || []).filter(c => (c.Icon || c.icon) === icon);

        if (usedFolders.length > 0) {
            const folderList = usedFolders.map(f => `  • "${f.Name || f.name}"`).join('\n');
            alert(
                `⚠️ Yeh icon abhi delete nahi kiya ja sakta!\n\n` +
                `Yeh icon abhi ${usedFolders.length} folder(s) mein use ho raha hai:\n` +
                folderList + `\n\n` +
                `Jab tak yeh folder(s) is icon ko use kar rahe hain, tab tak ise delete nahi kiya ja sakta.\n` +
                `Kripya pehle un folders ka icon change karein.`
            );
            return;
        }

        if (!confirm(`Yeh icon kisi bhi folder mein use nahi ho raha hai (0 places).\n\nKya aap ise apni custom icons list se delete karna chahte hain?`)) {
            return;
        }

        let list = getCustomFolderIcons();
        list = list.filter(item => item !== icon);
        saveCustomFolderIcons(list);

        // Refresh grids with current values
        const createSelected = document.getElementById('catIconInput')?.value || '📁';
        const editSelected = document.getElementById('editCatIconInput')?.value || '📁';

        populateIconGrid('catIconGrid', createSelected, 'selectFolderIcon');
        populateIconGrid('editCatIconGrid', editSelected, 'selectEditFolderIcon');

        // If the deleted icon was selected, reset to default 📁
        if (createSelected === icon) selectFolderIcon('📁');
        if (editSelected === icon) selectEditFolderIcon('📁');
    }

    function populateIconGrid(gridId, selectedIcon, clickHandlerName) {
        const grid = document.getElementById(gridId);
        if (!grid) return;
        grid.innerHTML = '';

        const customIcons = getCustomFolderIcons();

        // If selectedIcon is custom (not in FOLDER_ICONS and not yet in custom list), dynamically register it
        if (selectedIcon && !FOLDER_ICONS.some(f => f.icon === selectedIcon) && !customIcons.includes(selectedIcon)) {
            customIcons.unshift(selectedIcon);
            saveCustomFolderIcons(customIcons);
        }

        // 1. Render Custom Icons first (with hover delete badge)
        customIcons.forEach(icon => {
            const isImage = icon.startsWith('http') || icon.startsWith('data:image') || icon.startsWith('/uploads/');
            const usedIn = (window.EXISTING_CATEGORIES || []).filter(c => (c.Icon || c.icon) === icon);

            const wrapper = document.createElement('div');
            wrapper.className = 'custom-icon-wrapper position-relative d-inline-flex';

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = `folder-icon-btn ${selectedIcon === icon ? 'active' : ''}`;
            btn.setAttribute('data-icon', icon);
            btn.setAttribute('data-cat', 'custom');
            btn.title = isImage ? `Custom Image (${usedIn.length} in use)` : `Custom Icon: ${icon}`;

            if (isImage) {
                btn.innerHTML = `<img src="${icon}" style="width:26px; height:26px; object-fit:cover; border-radius:4px;" />`;
            } else {
                btn.innerText = icon;
            }
            btn.onclick = () => window[clickHandlerName](icon);
            wrapper.appendChild(btn);

            // Delete badge button (✕)
            const delBadge = document.createElement('button');
            delBadge.type = 'button';
            delBadge.className = 'btn-delete-custom-icon';
            delBadge.title = usedIn.length > 0 ? `Cannot delete: in use by ${usedIn.length} folder(s)` : `Delete custom icon`;
            delBadge.innerHTML = '✕';
            delBadge.onclick = (e) => deleteCustomFolderIcon(icon, e);
            wrapper.appendChild(delBadge);

            grid.appendChild(wrapper);
        });

        // 2. Render Curated Preset FOLDER_ICONS
        FOLDER_ICONS.forEach(item => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = `folder-icon-btn ${selectedIcon === item.icon ? 'active' : ''}`;
            btn.setAttribute('data-icon', item.icon);
            btn.setAttribute('data-cat', item.cat);
            btn.title = `${item.cat}: ${item.icon}`;
            btn.innerText = item.icon;
            btn.onclick = () => window[clickHandlerName](item.icon);
            grid.appendChild(btn);
        });

        updateCustomIconCount();
    }

    function filterIconTabs(category, tabBtn, gridId) {
        const tabsContainer = tabBtn.parentElement;
        tabsContainer.querySelectorAll('button').forEach(b => {
            b.classList.remove('active', 'btn-outline-info');
            b.classList.add('btn-outline-secondary');
        });
        tabBtn.classList.remove('btn-outline-secondary');
        tabBtn.classList.add('active', 'btn-outline-info');

        const grid = document.getElementById(gridId);
        if (!grid) return;
        const iconButtons = grid.querySelectorAll('.folder-icon-btn');
        iconButtons.forEach(btn => {
            const cat = btn.getAttribute('data-cat');
            const target = btn.closest('.custom-icon-wrapper') || btn;
            if (category === 'all' || cat === category) {
                target.style.display = 'inline-flex';
            } else {
                target.style.display = 'none';
            }
        });
    }

    // --- CREATE CATEGORY ACTIONS ---
    function selectFolderIcon(icon) {
        const input = document.getElementById('catIconInput');
        if (input) input.value = icon;
        const display = document.getElementById('catCurrentIconDisplay');
        if (display) display.innerHTML = renderIconHtml(icon, 32);
        const label = document.getElementById('selectedIconLabel');
        if (label) label.innerHTML = renderIconHtml(icon, 20);
        const preview = document.getElementById('catPreviewIconBox');
        if (preview) preview.innerHTML = renderIconHtml(icon, 38);
        const titleIcon = document.getElementById('modalTitleIcon');
        if (titleIcon) titleIcon.innerHTML = renderIconHtml(icon, 22);

        const grid = document.getElementById('catIconGrid');
        if (grid) {
            grid.querySelectorAll('.folder-icon-btn').forEach(btn => {
                if (btn.getAttribute('data-icon') === icon) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
        }
    }

    function onCustomIconInput(val) {
        val = (val || '').trim();
        const icon = val || '📁';
        selectFolderIcon(icon);
    }

    function onColorChanged(color) {
        const code = document.getElementById('selectedColorCode');
        if (code) code.innerText = color;
        const preview = document.getElementById('catPreviewIconBox');
        if (preview) {
            preview.style.borderColor = color;
            preview.style.backgroundColor = color + '26';
            preview.style.boxShadow = `0 0 16px ${color}4d`;
        }
        const card = document.getElementById('catLivePreviewCard');
        if (card) {
            card.style.borderLeftColor = color;
        }
        const badge = document.querySelector('#catLivePreviewCard .badge');
        if (badge) {
            badge.style.backgroundColor = color + '2b';
            badge.style.color = color;
            badge.style.borderColor = color + '66';
        }
        const swatches = document.getElementById('colorSwatchesContainer');
        if (swatches) {
            swatches.querySelectorAll('.color-swatch-btn').forEach(btn => {
                const swatchColor = btn.style.getPropertyValue('--swatch-color');
                if (swatchColor && swatchColor.toLowerCase() === color.toLowerCase()) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
        }
    }

    function applyColorSwatch(color, btn) {
        const input = document.getElementById('catColorInput');
        if (input) input.value = color;
        onColorChanged(color);
        if (btn && btn.parentElement) {
            btn.parentElement.querySelectorAll('.color-swatch-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }
    }

    function updateFolderLivePreview() {
        const input = document.getElementById('catNameInput');
        const preview = document.getElementById('catPreviewName');
        if (input && preview) {
            preview.innerText = input.value.trim() || 'New Folder';
        }
    }

    function applyFolderTemplate(name, icon, color) {
        const nameInput = document.getElementById('catNameInput');
        if (nameInput) {
            nameInput.value = name;
            updateFolderLivePreview();
        }
        selectFolderIcon(icon);
        const colorInput = document.getElementById('catColorInput');
        if (colorInput) colorInput.value = color;
        onColorChanged(color);
    }

    // --- EDIT CATEGORY ACTIONS ---
    function openEditCategoryFromTrigger(btn) {
        if (!btn) return;
        const catId = btn.getAttribute('data-cat-id');
        openEditCategoryModal(catId);
    }

    function openEditCategoryModal(id, name, icon, color, totalItems) {
        // Find category from existing list if not all args provided or if called by id
        const cat = (window.EXISTING_CATEGORIES || []).find(c => (c.Id || c.id) === id);
        if (cat) {
            name = name ?? (cat.Name || cat.name);
            icon = icon ?? (cat.Icon || cat.icon);
            color = color ?? (cat.Color || cat.color);
            totalItems = totalItems ?? (cat.TotalItems || cat.totalItems);
        }

        icon = icon || '📁';
        color = color || '#06b6d4';
        totalItems = parseInt(totalItems, 10);
        if (isNaN(totalItems)) totalItems = 0;

        document.getElementById('editCatId').value = id;
        document.getElementById('deleteCatId').value = id;
        document.getElementById('editCatNameInput').value = name || '';
        document.getElementById('editCatPreviewName').innerText = name || 'Folder Name';

        // Close cropper box if open
        cancelCropper('edit');

        // Reset image file and URL inputs
        const editImgUrl = document.getElementById('editImgUrlInput');
        if (editImgUrl) editImgUrl.value = '';
        const editImgFile = document.getElementById('editImgFileInput');
        if (editImgFile) editImgFile.value = '';

        // Populate edit icon grid and select the folder's existing icon
        populateIconGrid('editCatIconGrid', icon, 'selectEditFolderIcon');
        selectEditFolderIcon(icon);

        // Reset filter tab to 'all'
        const allTab = document.querySelector('.edit-cat-icon-tab[data-cat="all"]');
        if (allTab) {
            filterIconTabs('all', allTab, 'editCatIconGrid');
        }

        // Color accent
        document.getElementById('editCatColorInput').value = color;
        onEditColorChanged(color);

        // Empty folder rule for deletion
        const statusBox = document.getElementById('editFolderItemStatus');
        const delBtn = document.getElementById('btnDeleteCategory');

        if (totalItems > 0) {
            if (statusBox) {
                statusBox.innerHTML = `
                    <div class="alert alert-warning py-2 px-3 small d-flex align-items-center justify-content-between mb-3" style="background:rgba(245, 158, 11, 0.12); border:1px solid rgba(245, 158, 11, 0.35); color:#fbbf24; border-radius:10px;">
                        <div class="d-flex align-items-center gap-2">
                            <span style="font-size:1.15rem;">⚠️</span>
                            <span>Folder contains <strong class="text-white">${totalItems} item${totalItems > 1 ? 's' : ''}</strong>. It cannot be deleted until all items inside are moved or deleted.</span>
                        </div>
                    </div>`;
            }
            if (delBtn) {
                delBtn.disabled = true;
                delBtn.style.opacity = '0.4';
                delBtn.style.cursor = 'not-allowed';
                delBtn.title = `Cannot delete: folder contains ${totalItems} item(s). Empty folder first.`;
                delBtn.innerHTML = `🔒 Cannot Delete (${totalItems} items)`;
            }
        } else {
            if (statusBox) {
                statusBox.innerHTML = `
                    <div class="alert alert-success py-2 px-3 small d-flex align-items-center gap-2 mb-3" style="background:rgba(16, 185, 129, 0.1); border:1px solid rgba(16, 185, 129, 0.3); color:#6ee7b7; border-radius:10px;">
                        <span style="font-size:1.15rem;">✅</span>
                        <span>This folder is completely empty (0 items). It is safe to delete.</span>
                    </div>`;
            }
            if (delBtn) {
                delBtn.disabled = false;
                delBtn.style.opacity = '1';
                delBtn.style.cursor = 'pointer';
                delBtn.title = 'Delete this empty folder';
                delBtn.innerHTML = `🗑️ Delete Folder`;
            }
        }

        const modalEl = document.getElementById('editCategoryModal');
        if (modalEl) {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    }

    function selectEditFolderIcon(icon) {
        const input = document.getElementById('editCatIconInput');
        if (input) input.value = icon;
        const display = document.getElementById('editCatCurrentIconDisplay');
        if (display) display.innerHTML = renderIconHtml(icon, 32);
        const label = document.getElementById('editSelectedIconLabel');
        if (label) label.innerHTML = renderIconHtml(icon, 20);
        const preview = document.getElementById('editCatPreviewIconBox');
        if (preview) preview.innerHTML = renderIconHtml(icon, 38);
        const titleIcon = document.getElementById('editModalTitleIcon');
        if (titleIcon) titleIcon.innerHTML = renderIconHtml(icon, 22);

        const grid = document.getElementById('editCatIconGrid');
        if (grid) {
            grid.querySelectorAll('.folder-icon-btn').forEach(btn => {
                if (btn.getAttribute('data-icon') === icon) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
        }
    }

    function onEditCustomIconInput(val) {
        val = (val || '').trim();
        const icon = val || '📁';
        selectEditFolderIcon(icon);
    }

    function onEditColorChanged(color) {
        const code = document.getElementById('editSelectedColorCode');
        if (code) code.innerText = color;
        const preview = document.getElementById('editCatPreviewIconBox');
        if (preview) {
            preview.style.borderColor = color;
            preview.style.backgroundColor = color + '26';
            preview.style.boxShadow = `0 0 15px ${color}40`;
        }
        const card = document.getElementById('editCatLivePreviewCard');
        if (card) {
            card.style.borderLeftColor = color;
        }
        const badge = document.querySelector('#editCatLivePreviewCard .badge');
        if (badge) {
            badge.style.backgroundColor = color + '2b';
            badge.style.color = color;
            badge.style.borderColor = color + '66';
        }
        const swatches = document.getElementById('editColorSwatchesContainer');
        if (swatches) {
            swatches.querySelectorAll('.color-swatch-btn').forEach(btn => {
                const swatchColor = btn.style.getPropertyValue('--swatch-color');
                if (swatchColor && swatchColor.toLowerCase() === color.toLowerCase()) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
        }
    }

    function applyEditColorSwatch(color, btn) {
        const input = document.getElementById('editCatColorInput');
        if (input) input.value = color;
        onEditColorChanged(color);
        if (btn && btn.parentElement) {
            btn.parentElement.querySelectorAll('.color-swatch-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }
    }

    function updateEditFolderLivePreview() {
        const input = document.getElementById('editCatNameInput');
        const preview = document.getElementById('editCatPreviewName');
        if (input && preview) {
            preview.innerText = input.value.trim() || 'Folder Name';
        }
    }

    function submitDeleteCategory() {
        const delBtn = document.getElementById('btnDeleteCategory');
        if (delBtn && delBtn.disabled) {
            alert('Cannot delete this folder: It contains items. Only empty folders can be deleted.');
            return;
        }
        const name = document.getElementById('editCatNameInput').value;
        if (confirm(`Are you sure you want to delete empty folder "${name}"? This action cannot be undone.`)) {
            document.getElementById('deleteCategoryForm').submit();
        }
    }

    // Initialize icon grids on page load
    document.addEventListener('DOMContentLoaded', function() {
        populateIconGrid('catIconGrid', '📁', 'selectFolderIcon');
        populateIconGrid('editCatIconGrid', '📁', 'selectEditFolderIcon');
        updateCustomIconCount();

        const newCatModalEl = document.getElementById('newCategoryModal');
        if (newCatModalEl) {
            newCatModalEl.addEventListener('show.bs.modal', function() {
                const currentIcon = document.getElementById('catIconInput')?.value || '📁';
                cancelCropper('create');
                populateIconGrid('catIconGrid', currentIcon, 'selectFolderIcon');
                updateCustomIconCount();
            });
        }
    });
</script>
}
