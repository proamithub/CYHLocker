@model List<CYHLocker.Data.DTOs.VaultItemDto>
@inject Microsoft.Extensions.Configuration.IConfiguration AppConfig
@{
    ViewData["Title"] = "Encrypted Digital Vault";
    var categories = ViewBag.Categories as List<CYHLocker.Data.DTOs.VaultCategoryDto> ?? new();
    var counts = ViewBag.Counts as CYHLocker.Data.DTOs.VaultSidebarCountsDto ?? new();
    var selectedCat = ViewBag.SelectedCategory as string;
    var searchQuery = ViewBag.SearchQuery as string;
    var selectedType = ViewBag.SelectedType as string ?? "All";
    var favoritesOnly = ViewBag.FavoritesOnly == true;
    var currentSelectedCategory = categories.FirstOrDefault(c => c.Id == selectedCat);

    // One-time auto-expansion: Ensure [Icon] column in SQL table can store custom image data URLs
    try
    {
        var connStr = AppConfig.GetConnectionString("DefaultConnection");
        if (!string.IsNullOrEmpty(connStr))
        {
            using var dbCon = new Microsoft.Data.SqlClient.SqlConnection(connStr);
            dbCon.Open();
            using var alterCmd = new Microsoft.Data.SqlClient.SqlCommand(@"
                IF EXISTS (
                    SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS 
                    WHERE TABLE_NAME = 'VaultCategories_CYH' 
                      AND COLUMN_NAME = 'Icon' 
                      AND (CHARACTER_MAXIMUM_LENGTH < 500 AND CHARACTER_MAXIMUM_LENGTH > 0)
                )
                BEGIN
                    DECLARE @ConstraintName NVARCHAR(200);
                    SELECT @ConstraintName = d.name
                    FROM sys.default_constraints d
                    JOIN sys.columns c ON d.parent_object_id = c.object_id AND d.parent_column_id = c.column_id
                    WHERE d.parent_object_id = OBJECT_ID(N'[dbo].[VaultCategories_CYH]') AND c.name = 'Icon';

                    IF @ConstraintName IS NOT NULL
                    BEGIN
                        EXEC('ALTER TABLE [dbo].[VaultCategories_CYH] DROP CONSTRAINT [' + @ConstraintName + ']');
                    END;

                    ALTER TABLE [dbo].[VaultCategories_CYH] ALTER COLUMN [Icon] NVARCHAR(MAX) NULL;
                    ALTER TABLE [dbo].[VaultCategories_CYH] ADD DEFAULT ('📁') FOR [Icon];
                END", dbCon);
            alterCmd.ExecuteNonQuery();
        }
    }
    catch { }
}

<!-- ==========================================================================
     3-COLUMN ENCRYPTED VAULT MASTER LAYOUT
     ========================================================================== -->
<div class="vault-master-layout">

    <!-- ────────────────────────────────────────────────────────────────────────
         1. LEFT NAVIGATION SIDEBAR
         ──────────────────────────────────────────────────────────────────────── -->
    <aside class="vault-sidebar">
        <!-- Quick Action: Add Item Dropdown -->
        <div class="dropdown w-100 mb-2">
            <button class="btn btn-glow w-100 d-flex align-items-center justify-content-center gap-2 py-2" type="button" data-bs-toggle="dropdown" style="border-radius:12px; font-weight:600;">
                <span>➕</span> New Vault Item
            </button>
            <ul class="dropdown-menu dropdown-menu-dark w-100 shadow-lg" style="background:#0f172a; border-color:rgba(6,182,212,0.3); border-radius:12px;">
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-area="User" asp-controller="Vault" asp-action="Create" asp-route-type="Login">
                        <span>🌐</span> Login / Social Media
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-area="User" asp-controller="Vault" asp-action="Create" asp-route-type="Card">
                        <span>💳</span> Payment Card (Credit/Debit)
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-area="User" asp-controller="Vault" asp-action="Create" asp-route-type="Document">
                        <span>📄</span> Secure Encrypted Document
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-area="User" asp-controller="Vault" asp-action="Create" asp-route-type="ApiKey">
                        <span>🔑</span> Developer API Key / Secret
                    </a>
                </li>
            </ul>
        </div>

        <!-- Navigation Group: Vault Types -->
        <div class="vault-nav-group-title">Vault Items</div>
        <ul class="vault-nav-list">
            <li>
                <a class="vault-nav-link @(selectedType == "All" && !favoritesOnly && string.IsNullOrEmpty(selectedCat) ? "active" : "")"
                   asp-area="User" asp-controller="Vault" asp-action="Index">
                    <span class="vault-nav-link-left">
                        <span class="vault-nav-link-icon">📁</span>
                        <span>All Items</span>
                    </span>
                    <span class="vault-nav-badge">@counts.TotalAll</span>
                </a>
            </li>
            <li>
                <a class="vault-nav-link @(selectedType == "Login" ? "active" : "")"
                   asp-area="User" asp-controller="Vault" asp-action="Index" asp-route-type="Login">
                    <span class="vault-nav-link-left">
                        <span class="vault-nav-link-icon">🌐</span>
                        <span>Logins & Social</span>
                    </span>
                    <span class="vault-nav-badge">@(counts.TotalLogins + counts.TotalSocial)</span>
                </a>
            </li>
            <li>
                <a class="vault-nav-link @(selectedType == "Card" ? "active" : "")"
                   asp-area="User" asp-controller="Vault" asp-action="Index" asp-route-type="Card">
                    <span class="vault-nav-link-left">
                        <span class="vault-nav-link-icon">💳</span>
                        <span>Payment Cards</span>
                    </span>
                    <span class="vault-nav-badge">@counts.TotalCards</span>
                </a>
            </li>
            <li>
                <a class="vault-nav-link @(selectedType == "Document" ? "active" : "")"
                   asp-area="User" asp-controller="Vault" asp-action="Index" asp-route-type="Document">
                    <span class="vault-nav-link-left">
                        <span class="vault-nav-link-icon">📄</span>
                        <span>Secure Docs</span>
                    </span>
                    <span class="vault-nav-badge">@counts.TotalDocuments</span>
                </a>
            </li>
            <li>
                <a class="vault-nav-link @(selectedType == "ApiKey" ? "active" : "")"
                   asp-area="User" asp-controller="Vault" asp-action="Index" asp-route-type="ApiKey">
                    <span class="vault-nav-link-left">
                        <span class="vault-nav-link-icon">🔑</span>
                        <span>API Keys</span>
                    </span>
                    <span class="vault-nav-badge">@counts.TotalApiKeys</span>
                </a>
            </li>
            <li>
                <a class="vault-nav-link @(favoritesOnly ? "active" : "")"
                   asp-area="User" asp-controller="Vault" asp-action="Index" asp-route-favoritesOnly="true">
                    <span class="vault-nav-link-left">
                        <span class="vault-nav-link-icon text-warning">⭐</span>
                        <span>Favorites</span>
                    </span>
                    <span class="vault-nav-badge">@counts.TotalFavorites</span>
                </a>
            </li>
            <li>
                <a class="vault-nav-link" asp-area="User" asp-controller="Vault" asp-action="Trash">
                    <span class="vault-nav-link-left">
                        <span class="vault-nav-link-icon text-danger">🗑️</span>
                        <span>Trash</span>
                    </span>
                    <span class="vault-nav-badge">@counts.TotalTrash</span>
                </a>
            </li>
        </ul>

        <!-- Navigation Group: Folders / Categories -->
        <div class="d-flex align-items-center justify-content-between mt-2 mb-1 px-2">
            <span class="vault-nav-group-title m-0 p-0">Folders</span>
            <button type="button" class="btn btn-sm btn-link text-info p-0 text-decoration-none" data-bs-toggle="modal" data-bs-target="#newCategoryModal" title="New Folder">
                ➕ New
            </button>
        </div>
        <ul class="vault-nav-list">
            @foreach (var cat in categories)
            {
                var isSelected = selectedCat == cat.Id;
                var cColor = !string.IsNullOrEmpty(cat.Color) ? cat.Color : "#06b6d4";
                <li class="vault-nav-item-wrapper d-flex align-items-center position-relative mb-1">
                    <a class="vault-nav-link flex-grow-1 @(isSelected ? "active" : "")"
                       asp-area="User" asp-controller="Vault" asp-action="Index" asp-route-categoryId="@cat.Id"
                       style="border-left: 3.5px solid @cColor; @(isSelected ? $"background: linear-gradient(90deg, {cColor}2b 0%, rgba(15,23,42,0.5) 100%); box-shadow: inset 0 0 12px {cColor}22;" : "")">
                        <span class="vault-nav-link-left">
                            @if (!string.IsNullOrEmpty(cat.Icon) && (cat.Icon.StartsWith("http") || cat.Icon.StartsWith("/uploads/") || cat.Icon.StartsWith("data:image")))
                            {
                                <img src="@cat.Icon" alt="@cat.Name" style="width:20px; height:20px; object-fit:cover; border-radius:4px; margin-right:8px; display:inline-block; border:1px solid @(cColor)66;" />
                            }
                            else
                            {
                                <span class="vault-nav-link-icon" style="margin-right:6px; display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; border-radius:4px; background:@(cColor)1f;">@cat.Icon</span>
                            }
                            <span class="text-truncate" style="max-width:115px; color:@(isSelected ? "#fff" : "#e2e8f0"); font-weight:@(isSelected ? "600" : "500");">@cat.Name</span>
                        </span>
                        <span class="vault-nav-badge" style="background:@(cColor)22; color:@cColor; border:1px solid @(cColor)44; font-weight:600;">@cat.TotalItems</span>
                    </a>
                    <button type="button" class="vault-cat-edit-trigger text-muted" 
                            data-cat-id="@cat.Id"
                            onclick="event.preventDefault(); event.stopPropagation(); openEditCategoryFromTrigger(this)" 
                            title="Edit folder icon & name" style="font-size:0.75rem; margin-right:4px;">
                        ✏️
                    </button>
                </li>
            }
        </ul>

        <!-- Pro Tier Banner -->
        <div class="vault-pro-banner text-center mt-3">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                <span style="font-size:1.1rem;">💎</span>
                <span class="fw-bold text-light small">CYH Pro Vault</span>
            </div>
            <p class="text-muted small mb-2" style="font-size:0.75rem;">Unlimited items, multi-device cloud sync & Razorpay billing</p>
            <a asp-area="User" asp-controller="Subscription" asp-action="Index" class="btn btn-sm btn-outline-glow w-100 py-1" style="font-size:0.75rem;">
                Upgrade Now →
            </a>
        </div>
    </aside>

    <!-- ────────────────────────────────────────────────────────────────────────
         2. CENTER VAULT FEED (CARDS & SEARCH)
         ──────────────────────────────────────────────────────────────────────── -->
    <main class="vault-center-feed">
        <!-- Top Search and Filter Bar -->
        <div class="vault-control-card">
            <form method="get" asp-area="User" asp-controller="Vault" asp-action="Index" class="row g-2 align-items-center">
                <input type="hidden" name="type" value="@selectedType" />
                <input type="hidden" name="categoryId" value="@selectedCat" />
                <input type="hidden" name="favoritesOnly" value="@(favoritesOnly ? "true" : "false")" />

                <div class="col-12 col-md-8">
                    <div class="vault-search-box">
                        <span class="search-icon">🔍</span>
                        <input type="text" id="vaultSearchInput" name="q" value="@searchQuery" placeholder="Search by site, card, title, domain, or key..." autocomplete="off" />
                        <span class="kbd-hint">Ctrl + K</span>
                    </div>
                </div>
                <div class="col-12 col-md-4 d-flex justify-content-md-end gap-2">
                    <button type="submit" class="btn btn-sm btn-glow px-3">Filter</button>
                    @if (!string.IsNullOrEmpty(searchQuery) || !string.IsNullOrEmpty(selectedCat) || selectedType != "All" || favoritesOnly)
                    {
                        <a asp-area="User" asp-controller="Vault" asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
                    }
                </div>
            </form>
        </div>

        <!-- Section Title & Item Count Header -->
        <div class="d-flex align-items-center justify-content-between px-2">
            <div>
                @if (!string.IsNullOrEmpty(selectedCat) && currentSelectedCategory != null)
                {
                    var activeCol = !string.IsNullOrEmpty(currentSelectedCategory.Color) ? currentSelectedCategory.Color : "#06b6d4";
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:42px; height:42px; min-width:42px; display:flex; align-items:center; justify-content:center; border-radius:10px; background:@(activeCol)26; border:1.5px solid @(activeCol)66; box-shadow:0 0 15px @(activeCol)33;">
                            @if (!string.IsNullOrEmpty(currentSelectedCategory.Icon) && (currentSelectedCategory.Icon.StartsWith("http") || currentSelectedCategory.Icon.StartsWith("/uploads/") || currentSelectedCategory.Icon.StartsWith("data:image")))
                            {
                                <img src="@currentSelectedCategory.Icon" alt="@currentSelectedCategory.Name" style="width:32px; height:32px; object-fit:cover; border-radius:6px; display:inline-block;" />
                            }
                            else
                            {
                                <span style="font-size:1.6rem; line-height:1;">@currentSelectedCategory.Icon</span>
                            }
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h4 class="text-light fw-bold mb-0">@currentSelectedCategory.Name</h4>
                                <span class="badge" style="background:@(activeCol)22; color:@activeCol; border:1px solid @(activeCol)55; font-size:0.72rem; padding:3px 8px; border-radius:6px;">
                                    <span style="display:inline-block; width:7px; height:7px; border-radius:50%; background:@activeCol; margin-right:4px; box-shadow:0 0 6px @activeCol;"></span>Folder Accent
                                </span>
                                <button type="button" class="btn btn-sm py-0 px-2 rounded-pill ms-1"
                                        style="border:1px solid @(activeCol)88; color:@activeCol; background:@(activeCol)15; font-size:0.75rem;"
                                        data-cat-id="@currentSelectedCategory.Id"
                                        onclick="openEditCategoryFromTrigger(this)"
                                        title="Change folder icon, name or color">
                                    ✏️ Edit Folder
                                </button>
                            </div>
                            <span class="text-muted small">Folder filtered • Showing @Model.Count item(s)</span>
                        </div>
                    </div>
                }
                else
                {
                    <h4 class="text-light fw-bold mb-0">
                        @(selectedType == "All" ? "All Vault Items" : selectedType == "Card" ? "Payment Cards" : selectedType == "Document" ? "Secure Documents" : selectedType == "ApiKey" ? "Developer API Keys" : "Logins & Credentials")
                    </h4>
                    <span class="text-muted small">Showing @Model.Count item(s) protected by AES-256-GCM</span>
                }
            </div>
            <div class="d-flex gap-2">
                <a asp-area="User" asp-controller="Vault" asp-action="Create" asp-route-type="@(selectedType == "All" ? "Login" : selectedType)" asp-route-categoryId="@selectedCat" class="btn btn-sm btn-glow">
                    ➕ Add @(selectedType == "All" ? "Item" : selectedType)
                </a>
            </div>
        </div>

        <!-- Items Grid -->
        @if (Model.Count == 0)
        {
            <div class="glass-card text-center py-5 p-4" style="border: 2px dashed rgba(6, 182, 212, 0.25); border-radius:18px;">
                <div style="font-size:3.5rem;" class="mb-3">🛡️</div>
                <h4 class="fw-bold text-light mb-2">No Vault Items Found</h4>
                <p class="text-muted small mx-auto mb-4" style="max-width:440px;">
                    You haven't saved any credentials in this category yet. Click below to add your first encrypted item!
                </p>
                <a asp-area="User" asp-controller="Vault" asp-action="Create" asp-route-type="@(selectedType == "All" ? "Login" : selectedType)" class="btn btn-glow">
                    ➕ Add Item Now
                </a>
            </div>
        }
        else
        {
            <div class="vault-items-grid">
                @foreach (var item in Model)
                {
                    <div class="vault-item-card" onclick="openItemDrawer('@item.Id')">
                        <!-- Card Header -->
                        <div class="vault-card-head">
                            <div class="vault-brand-avatar">
                                @if (!string.IsNullOrEmpty(item.ItemIcon) && item.ItemIcon.StartsWith("http"))
                                {
                                    <img src="@item.ItemIcon" alt="@item.Title" onerror="this.onerror=null; this.parentElement.innerText='🌐';" />
                                }
                                else
                                {
                                    <span>@(string.IsNullOrEmpty(item.ItemIcon) ? "🌐" : item.ItemIcon)</span>
                                }
                            </div>
                            <div class="vault-card-meta">
                                <h6 class="vault-card-title" title="@item.Title">@item.Title</h6>
                                <p class="vault-card-subtitle" title="@item.SecondaryInfo">
                                    @(string.IsNullOrEmpty(item.SecondaryInfo) ? item.UrlDomain ?? item.ItemType : item.SecondaryInfo)
                                </p>
                            </div>
                            <form method="post" asp-area="User" asp-controller="Vault" asp-action="ToggleFavorite" asp-route-id="@item.Id" onclick="event.stopPropagation();">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="vault-star-btn @(item.IsFavorite ? "fav" : "")" title="Toggle Favorite">
                                    ★
                                </button>
                            </form>
                        </div>

                        <!-- Card Badges -->
                        <div class="d-flex align-items-center gap-2">
                            <span class="vault-type-badge @(item.ItemType.ToLower())">
                                @item.ItemType
                            </span>
                            @if (!string.IsNullOrEmpty(item.CategoryName))
                            {
                                var itemCat = categories.FirstOrDefault(c => c.Id == item.CategoryId);
                                var cardCatCol = !string.IsNullOrEmpty(item.CategoryColor) 
                                    ? item.CategoryColor 
                                    : (!string.IsNullOrEmpty(itemCat?.Color) ? itemCat.Color : "#06b6d4");
                                <span class="badge" style="background:@(cardCatCol)22; color:@cardCatCol; border:1px solid @(cardCatCol)55; font-size:0.72rem; border-radius:6px; font-weight:500;">
                                    📁 @item.CategoryName
                                </span>
                            }
                            @if (item.ItemType == "Login" && !string.IsNullOrEmpty(item.PasswordStrength))
                            {
                                <span class="badge" style="background:rgba(16,185,129,0.15); color:#34d399; font-size:0.68rem; margin-left:auto;">
                                    @item.PasswordStrength
                                </span>
                            }
                        </div>

                        <!-- Card Footer & Quick Copy -->
                        <div class="vault-card-footer" onclick="event.stopPropagation();">
                            <div class="vault-action-btn-group">
                                @if (item.ItemType == "Card")
                                {
                                    <button type="button" class="vault-mini-btn" onclick="copyCardNumber('@item.Id', this)" title="Copy Card Number">
                                        📋 Copy Number
                                    </button>
                                }
                                else if (item.ItemType == "Document")
                                {
                                    <button type="button" class="vault-mini-btn" onclick="openItemDrawer('@item.Id')" title="Read Document">
                                        📖 Read Doc
                                    </button>
                                }
                                else if (item.ItemType == "ApiKey")
                                {
                                    <button type="button" class="vault-mini-btn" onclick="copyApiKey('@item.Id', this)" title="Copy API Key">
                                        📋 Copy Key
                                    </button>
                                }
                                else
                                {
                                    @if (!string.IsNullOrEmpty(item.Username))
                                    {
                                        <button type="button" class="vault-mini-btn" onclick="copyText('@item.Username', this)" title="Copy Username">
                                            👤 User
                                        </button>
                                    }
                                    <button type="button" class="vault-mini-btn" onclick="copyPasswordDirect('@item.Id', this)" title="Copy Password">
                                        🔑 Pass
                                    </button>
                                }
                            </div>
                            <span class="small text-muted" style="font-size:0.75rem;">
                                @item.UpdatedAt.ToString("dd MMM")
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </main>

    <!-- ────────────────────────────────────────────────────────────────────────
         3. RIGHT DETAIL SLIDE-OUT DRAWER
         ──────────────────────────────────────────────────────────────────────── -->
    <aside class="vault-detail-drawer" id="itemDetailDrawer">
        <!-- Default Empty State -->
        <div id="drawerEmptyState" class="drawer-empty-state">
            <div style="font-size:3rem;" class="mb-2">👈</div>
            <h6 class="fw-bold text-light">Select any item to inspect</h6>
            <p class="small text-muted mb-0">Click on any card to view decrypted credentials, virtual card preview, or document notes.</p>
        </div>

        <!-- Dynamic Loaded Content Area -->
        <div id="drawerContent" style="display:none;">
            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom border-secondary">
                <div class="d-flex align-items-center gap-3">
                    <div class="vault-brand-avatar" id="drawerAvatar">
                        🌐
                    </div>
                    <div>
                        <h5 class="fw-bold text-light mb-0" id="drawerTitle">Title</h5>
                        <span class="small text-info" id="drawerSubtitle">Subtitle</span>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-link text-muted text-decoration-none" onclick="closeDrawer()" title="Close Drawer">
                    ✕
                </button>
            </div>

            <!-- Virtual Credit Card (Only for Card Type) -->
            <div id="drawerVirtualCard" class="virtual-credit-card" style="display:none;">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="vcard-chip"></div>
                    <span id="vcardBrand" class="fw-bold" style="font-size:1.1rem; letter-spacing:0.05em;">VISA</span>
                </div>
                <div class="vcard-number" id="vcardNumber">•••• •••• •••• ••••</div>
                <div class="vcard-footer">
                    <div>
                        <div class="small text-muted" style="font-size:0.6rem;">CARDHOLDER</div>
                        <div class="vcard-holder" id="vcardHolder">NAME SURNAME</div>
                    </div>
                    <div>
                        <div class="small text-muted" style="font-size:0.6rem;">EXPIRES</div>
                        <div class="vcard-exp" id="vcardExpiry">MM/YY</div>
                    </div>
                </div>
            </div>

            <!-- Dynamic Decrypted Fields -->
            <div id="drawerFields"></div>

            <!-- Notes Field -->
            <div class="drawer-field-card mt-2" id="drawerNotesCard" style="display:none;">
                <div class="drawer-field-label">Encrypted Notes</div>
                <div class="small text-light" id="drawerNotes" style="white-space: pre-wrap; font-family:inherit;"></div>
            </div>

            <!-- Action Buttons Footer -->
            <div class="d-flex gap-2 mt-4 pt-3 border-top border-secondary">
                <a id="drawerEditBtn" href="#" class="btn btn-sm btn-glow flex-grow-1">
                    ✏️ Edit Item
                </a>
                <form id="drawerDeleteForm" method="post" action="" onsubmit="return confirm('Move this item to Trash?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        🗑️ Delete
                    </button>
                </form>
            </div>
        </div>
    </aside>

</div>

<!-- Backdrop for Mobile Drawer -->
<div class="vault-drawer-backdrop" id="drawerBackdrop" onclick="closeDrawer()"></div>

<!-- ==========================================================================
     NEW CATEGORY MODAL (WITH INTERACTIVE FOLDER ICON SELECTOR)
     ========================================================================== -->
<div class="modal fade" id="newCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:560px; max-height:90vh; margin:1.5rem auto;">
        <div class="modal-content glass-card" style="background:#0b1120; border-color:rgba(6,182,212,0.3); color:#fff; box-shadow: 0 25px 60px rgba(0,0,0,0.7); max-height:90vh; display:flex; flex-direction:column; overflow:hidden;">
            <div class="modal-header border-bottom border-secondary py-3 px-4 flex-shrink-0" style="background:rgba(15,23,42,0.98);">
                <div class="d-flex align-items-center gap-2">
                    <span id="modalTitleIcon" style="font-size:1.4rem;">📁</span>
                    <h5 class="modal-title fw-bold m-0 text-light">Create New Folder / Category</h5>
                </div>
