@model List<CYHLocker.Data.DTOs.VaultItemDto>
@{
    ViewData["Title"] = "Encrypted Vault";
    var categories = ViewBag.Categories as List<CYHLocker.Data.DTOs.VaultCategoryDto> ?? new();
    var selectedCat = ViewBag.SelectedCategory as string;
    var searchQuery = ViewBag.SearchQuery as string;
}

<div class="vault-container">

    <!-- Top Vault Control Bar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="user-welcome-title mb-1">🔐 My Encrypted Vault</h2>
            <p class="user-welcome-sub">Zero-knowledge AES-256 protected credentials</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="User" asp-controller="Vault" asp-action="Create" class="btn btn-glow d-inline-flex align-items-center gap-2" style="border-radius:12px; padding:10px 20px;">
                <span>➕</span> Add New Password
            </a>
            <button type="button" class="btn btn-outline-glow" data-bs-toggle="modal" data-bs-target="#newCategoryModal" style="border-radius:12px; padding:10px 16px;">
                📁 New Category
            </button>
        </div>
    </div>

    <!-- Search & Category Filters -->
    <div class="glass-card p-3 mb-4" style="background:rgba(15, 22, 41, 0.7); border-color:rgba(6, 182, 212, 0.2);">
        <form method="get" asp-area="User" asp-controller="Vault" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-0 text-muted">🔍</span>
                    <input type="text" name="q" value="@searchQuery" class="form-control auth-input" placeholder="Search by site, title, or domain (e.g. google, bank)..." />
                </div>
            </div>
            <div class="col-12 col-md-5 d-flex flex-wrap gap-2 align-items-center">
                <a asp-area="User" asp-controller="Vault" asp-action="Index" 
                   class="badge text-decoration-none py-2 px-3 @(string.IsNullOrEmpty(selectedCat) ? "bg-info text-dark" : "bg-dark text-muted border border-secondary")" style="border-radius:20px;">
                    All (@Model.Count)
                </a>
                @foreach (var cat in categories)
                {
                    <a asp-area="User" asp-controller="Vault" asp-action="Index" asp-route-categoryId="@cat.Id"
                       class="badge text-decoration-none py-2 px-3 @(selectedCat == cat.Id ? "bg-info text-dark" : "bg-dark text-muted border border-secondary")"
                       style="border-radius:20px;">
                        @cat.Icon @cat.Name (@cat.TotalItems)
                    </a>
                }
            </div>
            <div class="col-12 col-md-2 text-md-end">
                <button type="submit" class="btn btn-sm btn-outline-glow w-100">Filter</button>
            </div>
        </form>
    </div>

    <!-- Vault Items Grid -->
    @if (Model.Count == 0)
    {
        <div class="glass-card text-center py-5 p-4" style="border: 2px dashed rgba(6, 182, 212, 0.25);">
            <div style="font-size:3.5rem;" class="mb-3">🛡️</div>
            <h4 class="fw-bold text-light mb-2">No Vault Items Found</h4>
            <p class="text-muted small mx-auto mb-4" style="max-width:440px;">
                You haven't saved any credentials in this category yet. Click below to add your first password with AES-256-GCM encryption!
            </p>
            <a asp-area="User" asp-controller="Vault" asp-action="Create" class="btn btn-glow">
                ➕ Add Your First Credential
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="user-card h-100 position-relative d-flex flex-column justify-content-between" style="border-radius:18px;">
                        
                        <!-- Top header of card -->
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="user-stat-icon teal m-0" style="width:40px; height:40px; font-size:1.2rem;">
                                        @item.ItemIcon
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-0 text-light" style="font-size:1.05rem;">
                                            <a asp-area="User" asp-controller="Vault" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-light">
                                                @item.Title
                                            </a>
                                        </h5>
                                        <small class="text-muted">@(item.UrlDomain ?? item.ItemType)</small>
                                    </div>
                                </div>
                                <form asp-area="User" asp-controller="Vault" asp-action="ToggleFavorite" asp-route-id="@item.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm p-0 border-0 bg-transparent" title="Toggle Favorite">
                                        <span style="font-size:1.3rem;">@(item.IsFavorite ? "⭐" : "☆")</span>
                                    </button>
                                </form>
                            </div>

                            <!-- Category & Strength Tags -->
                            <div class="d-flex gap-2 align-items-center mb-3">
                                @if (!string.IsNullOrEmpty(item.CategoryName))
                                {
                                    <span class="badge" style="background:rgba(6,182,212,0.15); color:#67e8f9; border:1px solid rgba(6,182,212,0.3);">
                                        📁 @item.CategoryName
                                    </span>
                                }
                                <span class="badge" style="background:rgba(16,185,129,0.15); color:#34d399; border:1px solid rgba(16,185,129,0.3);">
                                    🛡️ @item.PasswordStrength
                                </span>
                            </div>

                            <!-- Username / Email Field with Copy -->
                            @if (!string.IsNullOrEmpty(item.Username))
                            {
                                <div class="p-2 px-3 rounded mb-2 d-flex justify-content-between align-items-center" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06);">
                                    <span class="small text-muted text-truncate" style="max-width:180px;">@item.Username</span>
                                    <button type="button" class="btn btn-sm btn-link text-info p-0 text-decoration-none copy-btn" data-copy="@item.Username" title="Copy Username">
                                        📋 Copy
                                    </button>
                                </div>
                            }

                            <!-- Password Field with Quick Copy -->
                            <div class="p-2 px-3 rounded mb-3 d-flex justify-content-between align-items-center" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06);">
                                <span class="small font-monospace text-muted">••••••••••••</span>
                                <button type="button" class="btn btn-sm btn-link text-warning p-0 text-decoration-none copy-btn" data-copy="@item.Password" title="Copy Encrypted Password">
                                    🔑 Copy
                                </button>
                            </div>
                        </div>

                        <!-- Card Action Footer -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top" style="border-color:rgba(255,255,255,0.06) !important;">
                            @if (!string.IsNullOrEmpty(item.Url))
                            {
                                <a href="@item.Url" target="_blank" rel="noopener noreferrer" class="small text-info text-decoration-none d-flex align-items-center gap-1">
                                    Launch Site ↗
                                </a>
                            }
                            else
                            {
                                <span></span>
                            }
                            <div class="d-flex gap-2">
                                <a asp-area="User" asp-controller="Vault" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-glow py-1 px-3">
                                    View
                                </a>
                                <a asp-area="User" asp-controller="Vault" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary py-1 px-2 text-light">
                                    ✏️
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal: New Category -->
<div class="modal fade" id="newCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card" style="background:#0c1222; border-color:rgba(6,182,212,0.3);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-light">📁 Create Vault Category</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-area="User" asp-controller="Vault" asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small">Category Name</label>
                        <input name="Name" class="form-control auth-input" placeholder="e.g. Social Media, Banking, Work..." required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-muted small">Icon / Emoji</label>
                            <input name="Icon" class="form-control auth-input" value="📁" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small">Color Tag</label>
                            <input name="Color" class="form-control auth-input" value="#06b6d4" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-glow">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Toast notification for copy to clipboard -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999">
    <div id="copyToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage">
                ✓ Copied to clipboard!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.copy-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const text = this.getAttribute('data-copy');
                if (text) {
                    navigator.clipboard.writeText(text).then(() => {
                        const toastEl = document.getElementById('copyToast');
                        const toast = new bootstrap.Toast(toastEl, { delay: 2000 });
                        toast.show();
                    });
                }
            });
        });
    </script>
}
