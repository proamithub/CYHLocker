@model CYHLocker.Data.DTOs.UpdateVaultItemRequestDto
@{
    ViewData["Title"] = "Edit Encrypted Item";
    var categories = ViewBag.Categories as List<CYHLocker.Data.DTOs.VaultCategoryDto> ?? new();
    var selectedType = Model.ItemType ?? "Login";
}

<div class="container py-4" style="max-width:840px;">

    <!-- Back Navigation -->
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <a asp-area="User" asp-controller="Vault" asp-action="Index" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" style="border-radius:10px;">
            ← Back to Vault
        </a>
        <span class="badge" style="background:rgba(6,182,212,0.15); color:#67e8f9; font-size:0.8rem; border-radius:8px;">
            Editing @selectedType Item
        </span>
    </div>

    <!-- Edit Form Card -->
    <div class="glass-card p-4 p-md-5" style="border-radius:20px; border-color:rgba(6,182,212,0.3); background:rgba(15,23,42,0.85); box-shadow:0 20px 50px rgba(0,0,0,0.5);">
        
        <div class="text-center mb-4">
            <h2 class="fw-bold text-light mb-1">✏️ Edit Vault Item</h2>
            <p class="text-muted small">Changes will be re-encrypted using AES-256-GCM before saving</p>
        </div>

        <form method="post" asp-area="User" asp-controller="Vault" asp-action="Edit">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ItemType" value="@selectedType" />
            <input type="hidden" asp-for="ItemIcon" />

            <!-- Title & Category Header -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <label class="form-label text-light fw-semibold small">Item Title <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control auth-input" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label text-light fw-semibold small">Category / Folder</label>
                    <select asp-for="CategoryId" class="form-select auth-input">
                        <option value="">(No Category / Unfiled)</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.Icon @cat.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex align-items-end">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="IsFavorite" id="favSwitch" style="cursor:pointer;" />
                        <label class="form-check-label text-light small" for="favSwitch">★ Favorite</label>
                    </div>
                </div>
            </div>

            <!-- Type Specific Form Panels -->
            @if (selectedType == "Card")
            {
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label text-light fw-semibold small">Cardholder Name</label>
                        <input asp-for="CardholderName" class="form-control auth-input" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label text-light fw-semibold small">Card Brand / Network</label>
                        <select asp-for="CardBrand" class="form-select auth-input">
                            <option value="Visa">Visa</option>
                            <option value="MasterCard">MasterCard</option>
                            <option value="RuPay">RuPay</option>
                            <option value="Amex">American Express</option>
                            <option value="Discover">Discover</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label text-light fw-semibold small">Card Number</label>
                        <input asp-for="CardNumber" class="form-control auth-input" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label text-light fw-semibold small">Exp Month / Year</label>
                        <div class="d-flex gap-2">
                            <input asp-for="CardExpiryMonth" class="form-control auth-input text-center" placeholder="MM" maxlength="2" />
                            <input asp-for="CardExpiryYear" class="form-control auth-input text-center" placeholder="YY" maxlength="2" />
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label text-light fw-semibold small">CVV</label>
                        <input asp-for="CardCvv" type="password" class="form-control auth-input text-center" placeholder="123" maxlength="4" />
                    </div>
                </div>
            }
            else if (selectedType == "Document")
            {
                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <div class="p-3 rounded-3" style="background:rgba(6,182,212,0.06); border:1px dashed rgba(6,182,212,0.35);">
                            <label class="form-label text-light fw-semibold small d-flex justify-content-between align-items-center mb-2">
                                <span>📎 Replace / Upload File (PDF, Image, Doc, Text)</span>
                                <span class="badge bg-info text-dark" id="fileStatusBadge" style="display:none;">Ready</span>
                            </label>
                            <input type="file" id="filePickerInput" class="form-control auth-input" onchange="onFileSelected(this)" />
                            <span class="small text-muted mt-1 d-block" style="font-size:0.75rem;">
                                Uploading a new file will replace the encrypted payload with the new file contents.
                            </span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label text-light fw-semibold small">File Name</label>
                        <input asp-for="DocFileName" id="DocFileName" class="form-control auth-input" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label text-light fw-semibold small">File Size / Format</label>
                        <input asp-for="DocFileSize" id="DocFileSize" class="form-control auth-input" />
                    </div>
                    <div class="col-12">
                        <label class="form-label text-light fw-semibold small">Encrypted Document Body / Markdown Notes</label>
                        <textarea asp-for="DocContent" id="DocContent" rows="6" class="form-control auth-input font-monospace"></textarea>
                    </div>
                </div>
            }
            else if (selectedType == "ApiKey")
            {
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label text-light fw-semibold small">Environment</label>
                        <select asp-for="ApiEnvironment" class="form-select auth-input">
                            <option value="Production">Production</option>
                            <option value="Staging">Staging</option>
                            <option value="Development">Development</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label text-light fw-semibold small">Endpoint URL</label>
                        <input asp-for="Url" class="form-control auth-input" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label text-light fw-semibold small">API Key / Client ID</label>
                        <input asp-for="ApiKey" class="form-control auth-input font-monospace" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label text-light fw-semibold small">API Secret</label>
                        <input asp-for="ApiSecret" type="password" class="form-control auth-input font-monospace" />
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label text-light fw-semibold small">Username or Email</label>
                        <input asp-for="Username" class="form-control auth-input" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label text-light fw-semibold small">Password</label>
                        <div class="input-group">
                            <input asp-for="Password" id="vaultPasswordInput" type="password" class="form-control auth-input" />
                            <button type="button" class="btn btn-outline-secondary" onclick="togglePassEye('vaultPasswordInput', this)">👁️</button>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label text-light fw-semibold small">Website URL</label>
                        <input asp-for="Url" class="form-control auth-input" />
                    </div>
                </div>
            }

            <!-- Common Notes -->
            <div class="mb-4">
                <label class="form-label text-light fw-semibold small">Extra Secure Notes (Encrypted)</label>
                <textarea asp-for="Notes" rows="2" class="form-control auth-input"></textarea>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary">
                <a asp-area="User" asp-controller="Vault" asp-action="Index" class="btn btn-secondary px-4 py-2" style="border-radius:12px;">
                    Cancel
                </a>
                <button type="submit" class="btn btn-glow px-5 py-2" style="border-radius:12px; font-weight:600;">
                    💾 Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function togglePassEye(inputId, btn) {
        const input = document.getElementById(inputId);
        if (input.type === 'password') {
            input.type = 'text';
            btn.innerText = '🔒';
        } else {
            input.type = 'password';
            btn.innerText = '👁️';
        }
    }

    function onFileSelected(input) {
        const file = input.files[0];
        if (!file) return;

        const docFileName = document.getElementById('DocFileName');
        const docFileSize = document.getElementById('DocFileSize');
        const docContent = document.getElementById('DocContent');
        const statusBadge = document.getElementById('fileStatusBadge');

        docFileName.value = file.name;
        const sizeStr = file.size > 1024 * 1024 
            ? (file.size / (1024 * 1024)).toFixed(2) + ' MB'
            : (file.size / 1024).toFixed(1) + ' KB';
        docFileSize.value = `${sizeStr} (${file.type || 'Document'})`;

        statusBadge.innerText = `Loading ${file.name}...`;
        statusBadge.style.display = 'inline-block';
        statusBadge.className = 'badge bg-warning text-dark';

        const reader = new FileReader();
        if (file.type.startsWith('text/') || file.name.endsWith('.txt') || file.name.endsWith('.md') || file.name.endsWith('.json')) {
            reader.onload = function(e) {
                docContent.value = e.target.result;
                statusBadge.innerText = `✅ Loaded ${sizeStr}`;
                statusBadge.className = 'badge bg-success';
            };
            reader.readAsText(file);
        } else {
            reader.onload = function(e) {
                docContent.value = e.target.result;
                statusBadge.innerText = `✅ Encrypted Payload Ready (${sizeStr})`;
                statusBadge.className = 'badge bg-success';
            };
            reader.readAsDataURL(file);
        }
    }
</script>
}
