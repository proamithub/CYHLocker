@{
    ViewData["Title"] = "Dashboard";
}

<!-- ========================================================
     Admin Dashboard (Areas/Admin)
     ======================================================== -->

<!-- Stats Row -->
<div class="row g-4 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-stat-card">
            <div class="admin-stat-icon" style="background:rgba(220,38,38,0.15); color:#f87171;">👥</div>
            <div class="admin-stat-info">
                <div class="admin-stat-value">2</div>
                <div class="admin-stat-label">Total Users</div>
            </div>
            <div class="admin-stat-trend up">Live</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-stat-card">
            <div class="admin-stat-icon" style="background:rgba(234,179,8,0.15); color:#fbbf24;">🔐</div>
            <div class="admin-stat-info">
                <div class="admin-stat-value">Active</div>
                <div class="admin-stat-label">Sessions</div>
            </div>
            <div class="admin-stat-trend up">Live</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-stat-card">
            <div class="admin-stat-icon" style="background:rgba(16,185,129,0.15); color:#34d399;">✅</div>
            <div class="admin-stat-info">
                <div class="admin-stat-value">TOTP</div>
                <div class="admin-stat-label">MFA Service</div>
            </div>
            <div class="admin-stat-trend up">Ready</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-stat-card">
            <div class="admin-stat-icon" style="background:rgba(139,92,246,0.15); color:#c4b5fd;">🛡️</div>
            <div class="admin-stat-info">
                <div class="admin-stat-value">0</div>
                <div class="admin-stat-label">Security Alerts</div>
            </div>
            <div class="admin-stat-trend up">Normal</div>
        </div>
    </div>
</div>

<!-- Quick Actions + System Status -->
<div class="row g-4 mb-4">

    <!-- Quick Actions -->
    <div class="col-12 col-lg-5">
        <div class="admin-panel">
            <div class="admin-panel-header">
                <span>⚡ Quick Actions</span>
            </div>
            <div class="admin-panel-body">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Users" class="admin-action-btn mb-3">
                    <span>👥</span>
                    <div>
                        <div class="fw-semibold">Manage Users</div>
                        <div class="small opacity-75">View, lock, or delete accounts</div>
                    </div>
                    <span class="ms-auto">→</span>
                </a>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Reports" class="admin-action-btn mb-3">
                    <span>📈</span>
                    <div>
                        <div class="fw-semibold">View Reports</div>
                        <div class="small opacity-75">Login activity & security logs</div>
                    </div>
                    <span class="ms-auto">→</span>
                </a>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Settings" class="admin-action-btn">
                    <span>⚙️</span>
                    <div>
                        <div class="fw-semibold">System Settings</div>
                        <div class="small opacity-75">Configure app-wide options</div>
                    </div>
                    <span class="ms-auto">→</span>
                </a>
            </div>
        </div>
    </div>

    <!-- System Info -->
    <div class="col-12 col-lg-7">
        <div class="admin-panel">
            <div class="admin-panel-header">
                <span>🖥️ System Status</span>
                <span class="admin-status-pill active">All Systems Operational</span>
            </div>
            <div class="admin-panel-body">
                <div class="admin-status-row">
                    <span>🗄️ Database</span>
                    <span class="admin-badge-green">Connected (CYHLockerDB)</span>
                </div>
                <div class="admin-status-row">
                    <span>🔐 Auth Service</span>
                    <span class="admin-badge-green">Active</span>
                </div>
                <div class="admin-status-row">
                    <span>📱 MFA Service</span>
                    <span class="admin-badge-green">Active</span>
                </div>
                <div class="admin-status-row">
                    <span>🌐 API & Web Areas</span>
                    <span class="admin-badge-green">Running</span>
                </div>
                <div class="admin-status-row">
                    <span>📋 Session Store</span>
                    <span class="admin-badge-green">Active</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Phase Info -->
<div class="admin-info-bar">
    <span>✅</span>
    <span>
        <strong>CYHLocker Admin Area Active</strong> — Configured inside <code>Areas/Admin</code> with dedicated layout and CSS.
    </span>
</div>
